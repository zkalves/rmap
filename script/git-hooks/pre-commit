# Pre-commit hook: Runs static documentation parity checks and staged diff lockstep check
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"

if [ -f "$PROJECT_ROOT/script/check_doc_sync.py" ]; then
    python3 "$PROJECT_ROOT/script/check_doc_sync.py" --static
    if [ $? -ne 0 ]; then
        echo "❌ Pre-commit check failed: Documentation and implementation static parity violated."
        exit 1
    fi
fi

exit 0
