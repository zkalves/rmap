<ui version="4.0">
 <class>preferences</class>
 <widget class="QDialog" name="preferences">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>500</width>
    <height>280</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>400</width>
    <height>220</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Preferences</string>
  </property>
  <property name="windowIcon">
   <iconset resource="resources.qrc">
    <normaloff>:/icons/app_icon.png</normaloff>:/icons/app_icon.png</iconset>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <item>
    <widget class="QGroupBox" name="groupAppearance">
     <property name="title">
      <string>Appearance</string>
     </property>
     <layout class="QGridLayout" name="appearanceGridLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="label_colourScheme">
        <property name="text">
         <string>Colour Scheme:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="colourSchemeLayout">
        <item>
         <widget class="QComboBox" name="colourSchemeCombo"/>
        </item>
        <item>
         <widget class="QPushButton" name="btnOpenThemesFolder">
          <property name="text">
           <string>Themes Folder...</string>
          </property>
          <property name="toolTip">
           <string>Open custom themes directory to add or edit custom JSON themes</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_colourBlindMode">
        <property name="text">
         <string>Colour-Blind Mode:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <layout class="QHBoxLayout" name="colourBlindLayout">
        <item>
         <widget class="QCheckBox" name="colourBlindMode">
          <property name="text">
           <string>Enable</string>
          </property>
          <property name="toolTip">
           <string>Enable barrier-free high-contrast palette with explicit textual access policy tags</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="colourBlindCombo">
          <property name="toolTip">
           <string>Select Colour Vision Deficiency (CVD) profile</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_language">
        <property name="text">
         <string>Language:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="languageCombo"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
