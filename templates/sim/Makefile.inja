# =============================================================================
# Multi-Tool Simulation Makefile
# Generated by rmap - Hardware Register Map Designer
# =============================================================================

{% for blk in blocks %}
BLOCK_NAME   = {{ lower(blk.name) }}
DUT_MODULE   = {{ lower(blk.name) }}_reg_file
TB_MODULE    = tb_{{ lower(blk.name) }}_reg_file
{% endfor %}

TEST        ?= $(BLOCK_NAME)_hw_reset_test
SIM         ?= iverilog

# Dynamic Relative Paths computed during rmap export (overridable via CLI / env)
{% if exists("sim_rel_rtl_path") %}
RTL_SRC     ?= {{ sim_rel_rtl_path }}
{% else %}
RTL_SRC     ?= ../rtl/reg_map.sv
{% endif %}
{% if exists("sim_rel_uvm_path") %}
UVM_SRC     ?= {{ sim_rel_uvm_path }}
{% else %}
UVM_SRC     ?= ../uvm/reg_model.sv
{% endif %}
{% if exists("sim_rel_rtl_dir") %}
RTL_INC_DIR ?= {{ sim_rel_rtl_dir }}
{% else %}
RTL_INC_DIR ?= ../rtl
{% endif %}
{% if exists("sim_rel_uvm_dir") %}
UVM_INC_DIR ?= {{ sim_rel_uvm_dir }}
{% else %}
UVM_INC_DIR ?= ../uvm
{% endif %}

.PHONY: all help sim-rtl sim-verilator sim-pyuvm sim-uvm clean

help:
	@echo "Available Simulation Targets:"
	@echo "  make sim-rtl           Run self-checking SystemVerilog testbench in Icarus Verilog"
	@echo "  make sim-verilator     Run self-checking SystemVerilog testbench in Verilator"
	@echo "  make sim-pyuvm         Run open-source Python UVM testbench (pyuvm + cocotb)"
	@echo "  make sim-uvm SIM=vcs   Run IEEE 1800.2 (uvm-ieee) in Synopsys VCS"
	@echo "  make sim-uvm SIM=xrun  Run IEEE 1800.2 in Cadence Xcelium"
	@echo "  make sim-uvm SIM=mti   Run IEEE 1800.2 in Siemens Questa/ModelSim"
	@echo "  make clean             Clean all simulation artifacts"

# -----------------------------------------------------------------------------
# 1. Open-Source RTL Testbench (Icarus Verilog)
# -----------------------------------------------------------------------------
sim-rtl:
	iverilog -g2012 -o sim_rtl.vvp -I$(RTL_INC_DIR) $(RTL_SRC) tb_reg_map.sv
	vvp sim_rtl.vvp

# -----------------------------------------------------------------------------
# 2. Open-Source RTL Testbench (Verilator)
# -----------------------------------------------------------------------------
sim-verilator:
	verilator --binary -Wall -Wno-fatal -Wno-DECLFILENAME -I$(RTL_INC_DIR) $(RTL_SRC) tb_reg_map.sv --top-module $(TB_MODULE)
	./obj_dir/V$(TB_MODULE)

# -----------------------------------------------------------------------------
# 3. Open-Source Python UVM Testbench (pyuvm + Cocotb)
# -----------------------------------------------------------------------------
sim-pyuvm:
	MODULE=tb_pyuvm TOPLEVEL=$(DUT_MODULE) SIM=$(SIM) VERILOG_SOURCES="$(RTL_SRC)" make -f $$(cocotb-config --makefiles)/Makefile.sim

# -----------------------------------------------------------------------------
# 4. IEEE 1800.2 Standard (uvm-ieee) EDA Simulators
# -----------------------------------------------------------------------------
sim-uvm:
	@case "$(SIM)" in \
	  vcs) \
	    vcs -sverilog -ntb_opts uvm-ieee +incdir+$(RTL_INC_DIR) +incdir+$(UVM_INC_DIR) +incdir+uvm \
	      $(RTL_SRC) $(UVM_SRC) uvm/reg_bus_pkg.sv uvm/reg_env.sv uvm/reg_tests.sv uvm/tb_top.sv -o simv && \
	    ./simv +UVM_TESTNAME=$(TEST) ;; \
	  xrun|xcelium) \
	    xrun -uvm -uvmhome CDNS-1800.2 -incdir $(RTL_INC_DIR) -incdir $(UVM_INC_DIR) -incdir uvm \
	      $(RTL_SRC) $(UVM_SRC) uvm/reg_bus_pkg.sv uvm/reg_env.sv uvm/reg_tests.sv uvm/tb_top.sv +UVM_TESTNAME=$(TEST) ;; \
	  mti|questa) \
	    vlib work && \
	    vlog +incdir+$(RTL_INC_DIR) +incdir+$(UVM_INC_DIR) +incdir+uvm \
	      $(RTL_SRC) $(UVM_SRC) uvm/reg_bus_pkg.sv uvm/reg_env.sv uvm/reg_tests.sv uvm/tb_top.sv && \
	    vsim -c -do "run -all; quit" tb_top +UVM_TESTNAME=$(TEST) ;; \
	  *) \
	    echo "Specify SIM=vcs, SIM=xrun, or SIM=mti (or run 'make sim-rtl' for open-source)" ;; \
	esac

clean:
	rm -rf sim_rtl.vvp obj_dir simv* csrc work transcript *.vcd *.log *.key __pycache__ results.xml
