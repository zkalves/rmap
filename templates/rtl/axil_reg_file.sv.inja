{% for blk in blocks %}
// =============================================================================
// Module: {{ lower(blk.name) }}_axil_reg_file
// Description: AMBA AXI4-Lite Protocol Adapter for {{ blk.name }} Register File
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

timeunit 1ns;
timeprecision 1ps;

module {{ lower(blk.name) }}_axil_reg_file #(
  parameter int ADDR_WIDTH = 32,
  parameter int DATA_WIDTH = {{ reg_width }},
  parameter int STRB_WIDTH = DATA_WIDTH / 8,
  parameter bit PARAM_HW_PRECEDENCE = {% if exists("param_hw_precedence") %}{{ param_hw_precedence }}{% else if exists("hw_precedence") and hw_precedence %}1{% else %}1{% endif %},
  parameter bit ERROR_ON_WRITE_TO_RO = {% if exists("param_error_on_write_to_ro") %}{{ param_error_on_write_to_ro }}{% else if exists("error_on_write_to_ro") %}{{ error_on_write_to_ro }}{% else %}0{% endif %},
  parameter bit ERROR_ON_READ_FROM_WO = {% if exists("param_error_on_read_from_wo") %}{{ param_error_on_read_from_wo }}{% else if exists("error_on_read_from_wo") %}{{ error_on_read_from_wo }}{% else %}0{% endif %},
  parameter bit ERROR_ON_WRITE_TO_LOCKED = {% if exists("param_error_on_write_to_locked") %}{{ param_error_on_write_to_locked }}{% else if exists("error_on_write_to_locked") %}{{ error_on_write_to_locked }}{% else %}0{% endif %},
  parameter bit ERROR_ON_READ_FROM_LOCKED = {% if exists("param_error_on_read_from_locked") %}{{ param_error_on_read_from_locked }}{% else if exists("error_on_read_from_locked") %}{{ error_on_read_from_locked }}{% else %}0{% endif %}
)(
  // Hardware Core Sideband Signals
{% for reg in blk.registers %}
  // --- Register: {{ reg.name }} (Offset: {{ reg.offset_hex }}) ---
  output logic                      sw_{{ lower(reg.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_rd_strobe_o,
{% for fld in reg.fields %}
  output logic                      sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o,
{% if (existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE") or (upper(fld.access) == "RO" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WO" and upper(fld.hw_access) != "RW" and upper(fld.hw_access) != "W1T" and upper(fld.hw_access) != "INCR" and upper(fld.hw_access) != "DECR"))) %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WIRE" and upper(fld.hw_access) != "WO")) %}
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i,
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% endfor %}

{% endfor %}
{% if existsIn(blk, "lock_signals") and length(blk.lock_signals) > 0 %}
  // Hardware Write-Lock Control Input Ports (deduplicated)
{% for sig in blk.lock_signals %}
  input  logic                      {{ sig }},
{% endfor %}
{% endif %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // External Memory Subsystem Passthrough Ports
{% for mem in blk.memories %}
  output logic                      mem_{{ lower(mem.name) }}_req_o,
  output logic                      mem_{{ lower(mem.name) }}_we_o,
  output logic [ADDR_WIDTH-1:0]     mem_{{ lower(mem.name) }}_addr_o,
  output logic [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wdata_o,
  output logic [STRB_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wstrb_o,
  input  logic [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_rdata_i,
  input  logic                      mem_{{ lower(mem.name) }}_ready_i,
{% endfor %}
{% endif %}
  // AMBA AXI4-Lite Slave Bus Interface
  input  logic                      aclk_i,
  input  logic                      aresetn_i,

  // AXI4-Lite Write Address Channel
  input  logic [ADDR_WIDTH-1:0]     s_axil_awaddr_i,
  input  logic [2:0]                s_axil_awprot_i,
  input  logic                      s_axil_awvalid_i,
  output logic                      s_axil_awready_o,

  // AXI4-Lite Write Data Channel
  input  logic [DATA_WIDTH-1:0]     s_axil_wdata_i,
  input  logic [STRB_WIDTH-1:0]     s_axil_wstrb_i,
  input  logic                      s_axil_wvalid_i,
  output logic                      s_axil_wready_o,

  // AXI4-Lite Write Response Channel
  output logic [1:0]                s_axil_bresp_o,
  output logic                      s_axil_bvalid_o,
  input  logic                      s_axil_bready_i,

  // AXI4-Lite Read Address Channel
  input  logic [ADDR_WIDTH-1:0]     s_axil_araddr_i,
  input  logic [2:0]                s_axil_arprot_i,
  input  logic                      s_axil_arvalid_i,
  output logic                      s_axil_arready_o,

  // AXI4-Lite Read Data Channel
  output logic [DATA_WIDTH-1:0]     s_axil_rdata_o,
  output logic [1:0]                s_axil_rresp_o,
  output logic                      s_axil_rvalid_o,
  input  logic                      s_axil_rready_i
);

  logic unused_prot;
  assign unused_prot = |s_axil_awprot_i | |s_axil_arprot_i;

  // AXI4-Lite Internal Handshake State Machine
  logic aw_en;
  logic [ADDR_WIDTH-1:0] write_addr_q;
  logic write_addr_valid;

  // Write channel logic
  always_ff @(posedge aclk_i or negedge aresetn_i) begin
    if (!aresetn_i) begin
      s_axil_awready_o <= 1'b0;
      s_axil_wready_o  <= 1'b0;
      s_axil_bvalid_o  <= 1'b0;
      s_axil_bresp_o   <= 2'b00;
      aw_en            <= 1'b1;
      write_addr_valid <= 1'b0;
      write_addr_q     <= '0;
    end else begin
      // Address handshake
      if (~s_axil_awready_o && s_axil_awvalid_i && s_axil_wvalid_i && aw_en) begin
        s_axil_awready_o <= 1'b1;
        s_axil_wready_o  <= 1'b1;
        write_addr_q     <= s_axil_awaddr_i;
        write_addr_valid <= 1'b1;
        aw_en            <= 1'b0;
      end else begin
        s_axil_awready_o <= 1'b0;
        s_axil_wready_o  <= 1'b0;
        write_addr_valid <= 1'b0;
      end

      // Response generation
      if (s_axil_awready_o && s_axil_wready_o) begin
        s_axil_bvalid_o <= 1'b1;
        s_axil_bresp_o  <= bus_error ? 2'b10 : 2'b00; // 2'b10 = SLVERR, 2'b00 = OKAY
      end else if (s_axil_bready_i && s_axil_bvalid_o) begin
        s_axil_bvalid_o <= 1'b0;
        aw_en           <= 1'b1;
      end
    end
  end

  // Read channel logic
  logic [ADDR_WIDTH-1:0] read_addr_q;
  logic read_req;

  always_ff @(posedge aclk_i or negedge aresetn_i) begin
    if (!aresetn_i) begin
      s_axil_arready_o <= 1'b0;
      s_axil_rvalid_o  <= 1'b0;
      s_axil_rresp_o   <= 2'b00;
      s_axil_rdata_o   <= '0;
      read_addr_q      <= '0;
      read_req         <= 1'b0;
    end else begin
      if (~s_axil_arready_o && s_axil_arvalid_i) begin
        s_axil_arready_o <= 1'b1;
        read_addr_q      <= s_axil_araddr_i;
        read_req         <= 1'b1;
      end else begin
        s_axil_arready_o <= 1'b0;
        read_req         <= 1'b0;
      end

      if (read_req) begin
        s_axil_rvalid_o <= 1'b1;
        s_axil_rdata_o  <= bus_rdata;
        s_axil_rresp_o  <= bus_error ? 2'b10 : 2'b00;
      end else if (s_axil_rready_i && s_axil_rvalid_o) begin
        s_axil_rvalid_o <= 1'b0;
      end
    end
  end

  // Connect to generic register file core
  logic bus_wr_en;
  logic bus_rd_en;
  logic [ADDR_WIDTH-1:0] bus_addr;
  logic [DATA_WIDTH-1:0] bus_wdata;
  logic [STRB_WIDTH-1:0] bus_wstrb;
  logic [DATA_WIDTH-1:0] bus_rdata;
  logic bus_ready;
  logic bus_error;

  assign bus_wr_en = s_axil_awready_o && s_axil_wready_o;
  assign bus_rd_en = read_req;
  assign bus_addr  = bus_wr_en ? write_addr_q : read_addr_q;
  assign bus_wdata = s_axil_wdata_i;
  assign bus_wstrb = s_axil_wstrb_i;

  {{ lower(blk.name) }}_reg_file #(
    .ADDR_WIDTH(ADDR_WIDTH),
    .DATA_WIDTH(DATA_WIDTH),
    .STRB_WIDTH(STRB_WIDTH),
    .PARAM_HW_PRECEDENCE(PARAM_HW_PRECEDENCE),
    .ERROR_ON_WRITE_TO_RO(ERROR_ON_WRITE_TO_RO),
    .ERROR_ON_READ_FROM_WO(ERROR_ON_READ_FROM_WO),
    .ERROR_ON_WRITE_TO_LOCKED(ERROR_ON_WRITE_TO_LOCKED),
    .ERROR_ON_READ_FROM_LOCKED(ERROR_ON_READ_FROM_LOCKED)
  ) u_reg_file (
    .clk_i                     (aclk_i),
    .rst_ni                    (aresetn_i),
{% for reg in blk.registers %}
    .sw_{{ lower(reg.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_wr_strobe_o),
    .sw_{{ lower(reg.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_rd_strobe_o),
{% for fld in reg.fields %}
    .sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o),
    .sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o),
{% if (existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE") or (upper(fld.access) == "RO" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WO" and upper(fld.hw_access) != "RW" and upper(fld.hw_access) != "W1T" and upper(fld.hw_access) != "INCR" and upper(fld.hw_access) != "DECR"))) %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i),
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WIRE" and upper(fld.hw_access) != "WO")) %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i  (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i  (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i),
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% endif %}
{% endfor %}
{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
{% for mem in blk.memories %}
    .mem_{{ lower(mem.name) }}_req_o   (mem_{{ lower(mem.name) }}_req_o),
    .mem_{{ lower(mem.name) }}_we_o    (mem_{{ lower(mem.name) }}_we_o),
    .mem_{{ lower(mem.name) }}_addr_o  (mem_{{ lower(mem.name) }}_addr_o),
    .mem_{{ lower(mem.name) }}_wdata_o (mem_{{ lower(mem.name) }}_wdata_o),
    .mem_{{ lower(mem.name) }}_wstrb_o (mem_{{ lower(mem.name) }}_wstrb_o),
    .mem_{{ lower(mem.name) }}_rdata_i (mem_{{ lower(mem.name) }}_rdata_i),
    .mem_{{ lower(mem.name) }}_ready_i (mem_{{ lower(mem.name) }}_ready_i),
{% endfor %}
{% endif %}
{% if existsIn(blk, "lock_signals") and length(blk.lock_signals) > 0 %}
{% for sig in blk.lock_signals %}
    .{{ sig }}                     ({{ sig }}),
{% endfor %}
{% endif %}
    .bus_wr_en_i               (bus_wr_en),
    .bus_rd_en_i               (bus_rd_en),
    .bus_addr_i                (bus_addr),
    .bus_wdata_i               (bus_wdata),
    .bus_wstrb_i               (bus_wstrb),
    .bus_rdata_o               (bus_rdata),
    .bus_ready_o               (bus_ready),
    .bus_error_o               (bus_error)
  );

endmodule
{% endfor %}
