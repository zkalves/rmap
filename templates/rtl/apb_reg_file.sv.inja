{% for blk in blocks %}
// =============================================================================
// Module: {{ lower(blk.name) }}_apb_reg_file
// Description: AMBA APB4 Protocol Adapter for {{ blk.name }} Register File
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

timeunit 1ns;
timeprecision 1ps;

module {{ lower(blk.name) }}_apb_reg_file #(
  parameter int ADDR_WIDTH = 32,
  parameter int DATA_WIDTH = {{ reg_width }},
  parameter int STRB_WIDTH = DATA_WIDTH / 8,
  parameter bit PARAM_HW_PRECEDENCE = {% if exists("param_hw_precedence") %}{{ param_hw_precedence }}{% else if exists("hw_precedence") and hw_precedence %}1{% else %}1{% endif %}
)(
  input  logic                      pclk_i,
  input  logic                      prst_ni,

  // AMBA APB4 Slave Bus Interface
  input  logic                      psel_i,
  input  logic                      penable_i,
  input  logic                      pwrite_i,
  input  logic [ADDR_WIDTH-1:0]     paddr_i,
  input  logic [DATA_WIDTH-1:0]     pwdata_i,
  input  logic [STRB_WIDTH-1:0]     pstrb_i,
  input  logic [2:0]                pprot_i,
  output logic                      pready_o,
  output logic [DATA_WIDTH-1:0]     prdata_o,
  output logic                      pslverr_o,

  // Hardware Core Sideband Signals
{% for reg in blk.registers %}
  // --- Register: {{ reg.name }} (Offset: {{ reg.offset_hex }}) ---
  output logic                      sw_{{ lower(reg.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_rd_strobe_o,
{% for fld in reg.fields %}
  output logic                      sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o,
{% if upper(fld.access) == "RO" and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" %}
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i,
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i,
{% endif %}
{% endfor %}

{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // External Memory Subsystem Passthrough Ports
{% for mem in blk.memories %}
  output logic                      mem_{{ lower(mem.name) }}_req_o,
  output logic                      mem_{{ lower(mem.name) }}_we_o,
  output logic [ADDR_WIDTH-1:0]     mem_{{ lower(mem.name) }}_addr_o,
  output logic [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wdata_o,
  output logic [STRB_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wstrb_o,
  input  logic [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_rdata_i,
  input  logic                      mem_{{ lower(mem.name) }}_ready_i,
{% endfor %}
{% endif %}
);

  // Unused protection signals tied off cleanly
  logic unused_pprot;
  assign unused_pprot = |pprot_i;

  // Generic bus interface signals
  logic bus_wr_en;
  logic bus_rd_en;
  logic [STRB_WIDTH-1:0] bus_wstrb;

  // APB4 to Generic Bus Translation: strobes fire during access phase (PENABLE & PSEL)
  assign bus_wr_en = psel_i & penable_i & pwrite_i;
  assign bus_rd_en = psel_i & penable_i & ~pwrite_i;
  assign bus_wstrb = pwrite_i ? pstrb_i : '0;

  // Core Generic Register File Instance
  {{ lower(blk.name) }}_reg_file #(
    .ADDR_WIDTH(ADDR_WIDTH),
    .DATA_WIDTH(DATA_WIDTH),
    .STRB_WIDTH(STRB_WIDTH),
    .PARAM_HW_PRECEDENCE(PARAM_HW_PRECEDENCE)
  ) u_reg_file (
    .clk_i                     (pclk_i),
    .rst_ni                    (prst_ni),
{% for reg in blk.registers %}
    .sw_{{ lower(reg.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_wr_strobe_o),
    .sw_{{ lower(reg.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_rd_strobe_o),
{% for fld in reg.fields %}
    .sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o),
    .sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o),
{% if upper(fld.access) == "RO" and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i),
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i  (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i),
{% endif %}
{% endfor %}
{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
{% for mem in blk.memories %}
    .mem_{{ lower(mem.name) }}_req_o   (mem_{{ lower(mem.name) }}_req_o),
    .mem_{{ lower(mem.name) }}_we_o    (mem_{{ lower(mem.name) }}_we_o),
    .mem_{{ lower(mem.name) }}_addr_o  (mem_{{ lower(mem.name) }}_addr_o),
    .mem_{{ lower(mem.name) }}_wdata_o (mem_{{ lower(mem.name) }}_wdata_o),
    .mem_{{ lower(mem.name) }}_wstrb_o (mem_{{ lower(mem.name) }}_wstrb_o),
    .mem_{{ lower(mem.name) }}_rdata_i (mem_{{ lower(mem.name) }}_rdata_i),
    .mem_{{ lower(mem.name) }}_ready_i (mem_{{ lower(mem.name) }}_ready_i),
{% endfor %}
{% endif %}
    .bus_wr_en_i               (bus_wr_en),
    .bus_rd_en_i               (bus_rd_en),
    .bus_addr_i                (paddr_i),
    .bus_wdata_i               (pwdata_i),
    .bus_wstrb_i               (bus_wstrb),
    .bus_rdata_o               (prdata_o),
    .bus_ready_o               (pready_o),
    .bus_error_o               (pslverr_o)
  );

endmodule
{% endfor %}
