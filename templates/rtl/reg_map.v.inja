{% for blk in blocks %}
// =============================================================================
// Module: {{ lower(blk.name) }}_reg_file
// Description: Generic Bus-Agnostic Synthesizable Verilog-2001 Register File
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

module {{ lower(blk.name) }}_reg_file #(
  parameter ADDR_WIDTH = 32,
  parameter DATA_WIDTH = {{ reg_width }},
  parameter STRB_WIDTH = DATA_WIDTH / 8,
  parameter PARAM_HW_PRECEDENCE = {% if exists("param_hw_precedence") %}{{ param_hw_precedence }}{% else if exists("hw_precedence") and hw_precedence %}1{% else %}1{% endif %}
)(
  input  wire                      clk_i,
  input  wire                      rst_ni,

  // Hardware Core Sideband Signals
{% for reg in blk.registers %}
  // --- Register: {{ reg.name }} (Offset: {{ reg.offset_hex }}) ---
  output wire                      sw_{{ lower(reg.name) }}_wr_strobe_o,
  output wire                      sw_{{ lower(reg.name) }}_rd_strobe_o,
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
  input  wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
  input  wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
  output wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
  input  wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i,
  output wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" %}
  output wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  input  wire                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i,
  input  wire [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i,
{% endif %}
{% endfor %}

{% endfor %}

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // External Memory Subsystem Passthrough Ports
{% for mem in blk.memories %}
  // --- Memory: {{ mem.name }} (Offset: {{ mem.offset_hex }}, Size: {{ mem.size_width }} B) ---
  output wire                      mem_{{ lower(mem.name) }}_req_o,
  output wire                      mem_{{ lower(mem.name) }}_we_o,
  output wire [ADDR_WIDTH-1:0]     mem_{{ lower(mem.name) }}_addr_o,
  output wire [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wdata_o,
  output wire [STRB_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wstrb_o,
  input  wire [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_rdata_i,
  input  wire                      mem_{{ lower(mem.name) }}_ready_i,
{% endfor %}
{% endif %}
  // Protocol Bus Slave Interface (Protocol-Independent)
  input  wire                      bus_wr_en_i,
  input  wire                      bus_rd_en_i,
  input  wire [ADDR_WIDTH-1:0]     bus_addr_i,
  input  wire [DATA_WIDTH-1:0]     bus_wdata_i,
  input  wire [STRB_WIDTH-1:0]     bus_wstrb_i,
  output wire [DATA_WIDTH-1:0]     bus_rdata_o,
  output wire                      bus_ready_o,
  output wire                      bus_error_o
);

  // =========================================================================
  // Register & Memory Address Offsets
  // =========================================================================
{% for reg in blk.registers %}
  localparam [ADDR_WIDTH-1:0] ADDR_{{ upper(reg.name) }} = {{ sv_hex(reg.offset_hex, 32) }};
{% endfor %}
{% if existsIn(blk, "crc32_hex") %}
  localparam [31:0] REGMAP_CRC32 = {{ sv_hex(blk.crc32_hex, 32) }};
{% endif %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // Memory Window Address Parameters
{% for mem in blk.memories %}
  localparam [ADDR_WIDTH-1:0] MEM_{{ upper(mem.name) }}_START = {{ sv_hex(mem.offset_hex, 32) }};
  localparam [ADDR_WIDTH-1:0] MEM_{{ upper(mem.name) }}_SIZE  = {{ mem.size_width }};
  localparam [ADDR_WIDTH-1:0] MEM_{{ upper(mem.name) }}_END   = MEM_{{ upper(mem.name) }}_START + MEM_{{ upper(mem.name) }}_SIZE;
{% endfor %}

  // Memory Window Hit and Passthrough Logic
{% for mem in blk.memories %}
  wire mem_{{ lower(mem.name) }}_hit;
  assign mem_{{ lower(mem.name) }}_hit     = (bus_addr_i >= MEM_{{ upper(mem.name) }}_START) && (bus_addr_i < MEM_{{ upper(mem.name) }}_END);
  assign mem_{{ lower(mem.name) }}_req_o   = (bus_wr_en_i | bus_rd_en_i) & mem_{{ lower(mem.name) }}_hit;
  assign mem_{{ lower(mem.name) }}_we_o    = bus_wr_en_i & mem_{{ lower(mem.name) }}_hit;
  assign mem_{{ lower(mem.name) }}_addr_o  = mem_{{ lower(mem.name) }}_hit ? (bus_addr_i - MEM_{{ upper(mem.name) }}_START) : {ADDR_WIDTH{1'b0}};
  assign mem_{{ lower(mem.name) }}_wdata_o = bus_wdata_i;
  assign mem_{{ lower(mem.name) }}_wstrb_o = bus_wstrb_i;
{% endfor %}
{% endif %}

  // =========================================================================
  // Internal Register Storage Declarations
  // =========================================================================
{% for reg in blk.registers %}
  reg [DATA_WIDTH-1:0] reg_{{ lower(reg.name) }}_q, reg_{{ lower(reg.name) }}_d;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
  reg reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q, reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d;
{% endif %}
{% endfor %}
{% endfor %}

  // =========================================================================
  // SW Read / Write Strobe Generation
  // =========================================================================
{% for reg in blk.registers %}
  assign sw_{{ lower(reg.name) }}_wr_strobe_o = bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }}) && (|bus_wstrb_i);
  assign sw_{{ lower(reg.name) }}_rd_strobe_o = bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }});
{% endfor %}

  // =========================================================================
  // Register Next-State Logic & Hardware Updates
  // =========================================================================
  integer b;
  integer bit_idx;

{% for reg in blk.registers %}
  always @(*) begin : proc_{{ lower(reg.name) }}_next
    reg_{{ lower(reg.name) }}_d = reg_{{ lower(reg.name) }}_q;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
    reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d = reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q;
{% endif %}
{% endfor %}

    if (PARAM_HW_PRECEDENCE) begin
      // ---------------------------------------------------------------------
      // HW Precedence: SW access evaluated first, HW updates override
      // ---------------------------------------------------------------------
      // 1. SW Write Update
      if (sw_{{ lower(reg.name) }}_wr_strobe_o) begin
        for (b = 0; b < STRB_WIDTH; b = b + 1) begin
          if (bus_wstrb_i[b]) begin
            for (bit_idx = b * 8; bit_idx < (b + 1) * 8; bit_idx = bit_idx + 1) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" or upper(fld.access) == "WRC" or upper(fld.access) == "WRS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
              end
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W1CRS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W1S" or upper(fld.access) == "W1SRC" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W1T" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "W0C" or upper(fld.access) == "W0CRS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W0S" or upper(fld.access) == "W0SRC" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W0T" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "WC" or upper(fld.access) == "WOC" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
              end
{% else if upper(fld.access) == "WS" or upper(fld.access) == "WOS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
              end
{% else if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
                  reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d = 1'b1;
                end
              end
{% endif %}
{% endfor %}
            end
          end
        end
      end

      // 2. SW Read Side-Effects (RC, RS, WRC, WRS, W1SRC, W1CRS, W0SRC, W0CRS)
      if (sw_{{ lower(reg.name) }}_rd_strobe_o) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "WRC" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {({{ fld.size_width }}){1'b0}};
{% else if upper(fld.access) == "RS" or upper(fld.access) == "WRS" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {({{ fld.size_width }}){1'b1}};
{% endif %}
{% endfor %}
      end

      // 3. Hardware Updates (Override SW)
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] | hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
      end
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] & ~hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i;
      end
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i;
      end
{% endif %}
{% endfor %}

    end else begin
      // ---------------------------------------------------------------------
      // SW Precedence: HW updates evaluated first, SW access overrides
      // ---------------------------------------------------------------------
      // 1. Hardware Updates
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] | hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
      end
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] & ~hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i;
      end
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i;
      end
{% endif %}
{% endfor %}

      // 2. SW Write Update (Overrides HW)
      if (sw_{{ lower(reg.name) }}_wr_strobe_o) begin
        for (b = 0; b < STRB_WIDTH; b = b + 1) begin
          if (bus_wstrb_i[b]) begin
            for (bit_idx = b * 8; bit_idx < (b + 1) * 8; bit_idx = bit_idx + 1) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" or upper(fld.access) == "WRC" or upper(fld.access) == "WRS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
              end
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W1CRS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W1S" or upper(fld.access) == "W1SRC" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W1T" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "W0C" or upper(fld.access) == "W0CRS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W0S" or upper(fld.access) == "W0SRC" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W0T" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "WC" or upper(fld.access) == "WOC" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
              end
{% else if upper(fld.access) == "WS" or upper(fld.access) == "WOS" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
              end
{% else if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
              if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
                  reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d = 1'b1;
                end
              end
{% endif %}
{% endfor %}
            end
          end
        end
      end

      // 3. SW Read Side-Effects (Overrides HW)
      if (sw_{{ lower(reg.name) }}_rd_strobe_o) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "WRC" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {({{ fld.size_width }}){1'b0}};
{% else if upper(fld.access) == "RS" or upper(fld.access) == "WRS" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {({{ fld.size_width }}){1'b1}};
{% endif %}
{% endfor %}
      end
    end
  end

{% endfor %}

  // =========================================================================
  // Sequential Register Instantiation
  // =========================================================================
  always @(posedge clk_i or negedge rst_ni) begin : proc_reg_seq
    if (!rst_ni) begin
{% for reg in blk.registers %}
{% if existsIn(reg, "reset_hex") %}
      reg_{{ lower(reg.name) }}_q <= {{ sv_hex(reg.reset_val, reg_width) }};
{% else %}
      reg_{{ lower(reg.name) }}_q <= {DATA_WIDTH{1'b0}};
{% endif %}
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
      reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q <= 1'b0;
{% endif %}
{% endfor %}
{% endfor %}
    end else begin
{% for reg in blk.registers %}
      reg_{{ lower(reg.name) }}_q <= reg_{{ lower(reg.name) }}_d;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
      reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q <= reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d;
{% endif %}
{% endfor %}
{% endfor %}
    end
  end

  // =========================================================================
  // Bus Read Decode Logic
  // =========================================================================
  reg [DATA_WIDTH-1:0] bus_rdata_reg;
  reg                  bus_ready_reg;
  reg                  bus_error_reg;

  assign bus_rdata_o = bus_rdata_reg;
  assign bus_ready_o = bus_ready_reg;
  assign bus_error_o = bus_error_reg;

  always @(*) begin : proc_read_decode
    bus_rdata_reg = {DATA_WIDTH{1'b0}};
    bus_ready_reg = bus_wr_en_i | bus_rd_en_i; // Single-cycle response
    bus_error_reg = 1'b0;

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
    if (bus_rd_en_i || bus_wr_en_i) begin
      case (1'b1)
{% for mem in blk.memories %}
        mem_{{ lower(mem.name) }}_hit: begin
          bus_rdata_reg = mem_{{ lower(mem.name) }}_rdata_i;
          bus_ready_reg = mem_{{ lower(mem.name) }}_ready_i;
          bus_error_reg = 1'b0;
        end
{% endfor %}
        default: begin
          case (bus_addr_i)
{% for reg in blk.registers %}
            ADDR_{{ upper(reg.name) }}: begin
              bus_ready_reg = 1'b1;
              if (bus_rd_en_i) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and existsIn(fld, "hw_access") and upper(fld.hw_access) == "NA" %}
                bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {{ sv_hex(fld.reset_val, fld.size_width) }};
{% else if upper(fld.access) == "RO" %}
                bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
                bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {({{ fld.size_width }}){1'b0}};
{% else %}
                bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
              end
            end
{% endfor %}
            default: begin
              bus_rdata_reg = {DATA_WIDTH{1'b0}};
              bus_ready_reg = 1'b1;
              bus_error_reg = 1'b1;
            end
          endcase
        end
      endcase
    end
{% else %}
    if (bus_rd_en_i || bus_wr_en_i) begin
      case (bus_addr_i)
{% for reg in blk.registers %}
        ADDR_{{ upper(reg.name) }}: begin
          if (bus_rd_en_i) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and existsIn(fld, "hw_access") and upper(fld.hw_access) == "NA" %}
            bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {{ sv_hex(fld.reset_val, fld.size_width) }};
{% else if upper(fld.access) == "RO" %}
            bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
            bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {({{ fld.size_width }}){1'b0}};
{% else %}
            bus_rdata_reg[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
          end
        end
{% endfor %}
        default: begin
          bus_rdata_reg = {DATA_WIDTH{1'b0}};
          bus_error_reg = 1'b1;
        end
      endcase
    end
{% endif %}
  end

  // Output Signal Assignments
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" %}
  assign hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
{% endfor %}

endmodule
{% endfor %}
