{% for blk in blocks %}
// =============================================================================
// Module: {{ lower(blk.name) }}_reg_map_sva
// Description: Bindable Formal SystemVerilog Assertions (SVA) Module
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

timeunit 1ns;
timeprecision 1ps;

module {{ lower(blk.name) }}_reg_map_sva #(
  parameter int ADDR_WIDTH = 32,
  parameter int DATA_WIDTH = {{ reg_width }},
  parameter int STRB_WIDTH = DATA_WIDTH / 8,
  parameter bit PARAM_HW_PRECEDENCE = {% if exists("param_hw_precedence") %}{{ param_hw_precedence }}{% else if exists("hw_precedence") and hw_precedence %}1{% else %}1{% endif %},
  parameter bit ERROR_ON_WRITE_TO_RO = {% if exists("param_error_on_write_to_ro") %}{{ param_error_on_write_to_ro }}{% else if exists("error_on_write_to_ro") %}{{ error_on_write_to_ro }}{% else %}0{% endif %},
  parameter bit ERROR_ON_READ_FROM_WO = {% if exists("param_error_on_read_from_wo") %}{{ param_error_on_read_from_wo }}{% else if exists("error_on_read_from_wo") %}{{ error_on_read_from_wo }}{% else %}0{% endif %},
  parameter bit ERROR_ON_WRITE_TO_LOCKED = {% if exists("param_error_on_write_to_locked") %}{{ param_error_on_write_to_locked }}{% else if exists("error_on_write_to_locked") %}{{ error_on_write_to_locked }}{% else %}0{% endif %},
  parameter bit ERROR_ON_READ_FROM_LOCKED = {% if exists("param_error_on_read_from_locked") %}{{ param_error_on_read_from_locked }}{% else if exists("error_on_read_from_locked") %}{{ error_on_read_from_locked }}{% else %}0{% endif %}
)(
  input logic                      clk_i,
  input logic                      rst_ni,

  // Bus Interface Signals
  input logic                      bus_wr_en_i,
  input logic                      bus_rd_en_i,
  input logic [ADDR_WIDTH-1:0]     bus_addr_i,
  input logic [DATA_WIDTH-1:0]     bus_wdata_i,
  input logic [STRB_WIDTH-1:0]     bus_wstrb_i,
  input logic [DATA_WIDTH-1:0]     bus_rdata_o,
  input logic                      bus_ready_o,
  input logic                      bus_error_o,

  // Sideband Signals & Internal States
{% for reg in blk.registers %}
  input logic                      sw_{{ lower(reg.name) }}_wr_strobe_o,
  input logic                      sw_{{ lower(reg.name) }}_rd_strobe_o,
  input logic [DATA_WIDTH-1:0]     reg_{{ lower(reg.name) }}_q,
{% for fld in reg.fields %}
{% if (existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE") or (upper(fld.access) == "RO" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WO" and upper(fld.hw_access) != "RW" and upper(fld.hw_access) != "W1T" and upper(fld.hw_access) != "INCR" and upper(fld.hw_access) != "DECR"))) %}
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i,
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WIRE" and upper(fld.hw_access) != "WO")) %}
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  input logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i,
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i,
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
  input logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i,
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
  input logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i,
  input logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% endfor %}
{% endfor %}
{% if existsIn(blk, "lock_signals") and length(blk.lock_signals) > 0 %}
  // Hardware Write-Lock Control Input Ports
{% for sig in blk.lock_signals %}
  input logic                      {{ sig }},
{% endfor %}
{% endif %}
  input logic                      unused_dummy
);

  default clocking cb_clk @(posedge clk_i); endclocking
  default disable iff (!rst_ni);

  // Address constants
{% for reg in blk.registers %}
  localparam logic [ADDR_WIDTH-1:0] ADDR_{{ upper(reg.name) }} = {{ sv_hex(reg.offset_hex, 32) }};
{% endfor %}

  // -------------------------------------------------------------------------
  // 1. Single-Cycle Strobe Duration Assertions
  // -------------------------------------------------------------------------
{% for reg in blk.registers %}
  property p_sw_{{ lower(reg.name) }}_wr_strobe_pulse;
    $rose(sw_{{ lower(reg.name) }}_wr_strobe_o) |=> !sw_{{ lower(reg.name) }}_wr_strobe_o;
  endproperty
  assert_sw_{{ lower(reg.name) }}_wr_strobe_pulse: assert property (p_sw_{{ lower(reg.name) }}_wr_strobe_pulse)
    else $error("[SVA] sw_{{ lower(reg.name) }}_wr_strobe_o asserted for more than 1 consecutive cycle");

  property p_sw_{{ lower(reg.name) }}_rd_strobe_pulse;
    $rose(sw_{{ lower(reg.name) }}_rd_strobe_o) |=> !sw_{{ lower(reg.name) }}_rd_strobe_o;
  endproperty
  assert_sw_{{ lower(reg.name) }}_rd_strobe_pulse: assert property (p_sw_{{ lower(reg.name) }}_rd_strobe_pulse)
    else $error("[SVA] sw_{{ lower(reg.name) }}_rd_strobe_o asserted for more than 1 consecutive cycle");
{% endfor %}

  // -------------------------------------------------------------------------
  // 2. Read-Only (RO) Immutability on SW Writes
  // -------------------------------------------------------------------------
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and (not existsIn(fld, "hw_access") or upper(fld.hw_access) == "NA") %}
  property p_ro_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable;
    sw_{{ lower(reg.name) }}_wr_strobe_o |=> (reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == $past(reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}]));
  endproperty
  assert_ro_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable: assert property (p_ro_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable)
    else $error("[SVA] RO field {{ reg.name }}.{{ fld.name }} was modified by a software write!");
{% endif %}
{% endfor %}
{% endfor %}

  // -------------------------------------------------------------------------
  // 3. Write-Only (WO) Read-Zero Behavior
  // -------------------------------------------------------------------------
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
  property p_wo_{{ lower(reg.name) }}_{{ lower(fld.name) }}_read_zero;
    (bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> (bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == '0);
  endproperty
  assert_wo_{{ lower(reg.name) }}_{{ lower(fld.name) }}_read_zero: assert property (p_wo_{{ lower(reg.name) }}_{{ lower(fld.name) }}_read_zero)
    else $error("[SVA] Write-Only field {{ reg.name }}.{{ fld.name }} did not return 0 upon software read!");
{% endif %}
{% endfor %}
{% endfor %}

  // -------------------------------------------------------------------------
  // 4. Hardware vs Software Arbitration Precedence
  // -------------------------------------------------------------------------
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  property p_arb_{{ lower(reg.name) }}_{{ lower(fld.name) }};
    (sw_{{ lower(reg.name) }}_wr_strobe_o && hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i) |=>
      (PARAM_HW_PRECEDENCE ?
        (reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == $past(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i)) :
        (reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == $past(bus_wdata_i[{{ fld.offset_lsb }} +: {{ fld.size_width }}]))
      );
  endproperty
  assert_arb_{{ lower(reg.name) }}_{{ lower(fld.name) }}: assert property (p_arb_{{ lower(reg.name) }}_{{ lower(fld.name) }})
    else $error("[SVA] Arbitration failure on colliding HW/SW write for {{ reg.name }}.{{ fld.name }}!");
{% endif %}
{% endfor %}
{% endfor %}

  // -------------------------------------------------------------------------
  // 6. Software Lock Invariant Assertions
  // -------------------------------------------------------------------------
{% for reg in blk.registers %}
{% if existsIn(reg, "lock_wr") and reg.lock_wr != "" %}
  property p_lock_{{ lower(reg.name) }}_immutable;
    (({{ sv_lock_expr(reg.lock_wr) }}) && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |=> (reg_{{ lower(reg.name) }}_q == $past(reg_{{ lower(reg.name) }}_q));
  endproperty
  assert_lock_{{ lower(reg.name) }}_immutable: assert property (p_lock_{{ lower(reg.name) }}_immutable)
    else $error("[SVA] Software write modified register {{ reg.name }} while write-locked!");
{% else if existsIn(reg, "lock_wr_expr_sv") and reg.lock_wr_expr_sv != "" %}
  property p_lock_{{ lower(reg.name) }}_immutable;
    (({{ reg.lock_wr_expr_sv }}) && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |=> (reg_{{ lower(reg.name) }}_q == $past(reg_{{ lower(reg.name) }}_q));
  endproperty
  assert_lock_{{ lower(reg.name) }}_immutable: assert property (p_lock_{{ lower(reg.name) }}_immutable)
    else $error("[SVA] Software write modified register {{ reg.name }} while write-locked!");
{% else if existsIn(reg, "lock_expr_sv") and reg.lock_expr_sv != "" %}
  property p_lock_{{ lower(reg.name) }}_immutable;
    (({{ reg.lock_expr_sv }}) && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |=> (reg_{{ lower(reg.name) }}_q == $past(reg_{{ lower(reg.name) }}_q));
  endproperty
  assert_lock_{{ lower(reg.name) }}_immutable: assert property (p_lock_{{ lower(reg.name) }}_immutable)
    else $error("[SVA] Software write modified register {{ reg.name }} while write-locked!");
{% endif %}
{% if existsIn(reg, "lock_rd") and reg.lock_rd != "" %}
  property p_lock_{{ lower(reg.name) }}_rd_zero;
    (({{ sv_lock_expr(reg.lock_rd) }}) && bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> (bus_rdata_o == '0);
  endproperty
  assert_lock_{{ lower(reg.name) }}_rd_zero: assert property (p_lock_{{ lower(reg.name) }}_rd_zero)
    else $error("[SVA] Software read returned non-zero for register {{ reg.name }} while read-locked!");
{% else if existsIn(reg, "lock_rd_expr_sv") and reg.lock_rd_expr_sv != "" %}
  property p_lock_{{ lower(reg.name) }}_rd_zero;
    (({{ reg.lock_rd_expr_sv }}) && bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> (bus_rdata_o == '0);
  endproperty
  assert_lock_{{ lower(reg.name) }}_rd_zero: assert property (p_lock_{{ lower(reg.name) }}_rd_zero)
    else $error("[SVA] Software read returned non-zero for register {{ reg.name }} while read-locked!");
{% endif %}
{% endfor %}
{% if (existsIn(blk, "lock_wr") and blk.lock_wr != "") or (existsIn(blk, "lock_wr_expr_sv") and blk.lock_wr_expr_sv != "") %}
{% for reg in blk.registers %}
  property p_lock_blk_{{ lower(reg.name) }}_immutable;
    (({% if existsIn(blk, "lock_wr") and blk.lock_wr != "" %}{{ sv_lock_expr(blk.lock_wr) }}{% else %}{{ blk.lock_wr_expr_sv }}{% endif %}) && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |=> (reg_{{ lower(reg.name) }}_q == $past(reg_{{ lower(reg.name) }}_q));
  endproperty
  assert_lock_blk_{{ lower(reg.name) }}_immutable: assert property (p_lock_blk_{{ lower(reg.name) }}_immutable)
    else $error("[SVA] Software write modified register {{ reg.name }} while block write-locked!");
{% endfor %}
{% endif %}
{% if (existsIn(blk, "lock_rd") and blk.lock_rd != "") or (existsIn(blk, "lock_rd_expr_sv") and blk.lock_rd_expr_sv != "") %}
{% for reg in blk.registers %}
  property p_lock_blk_{{ lower(reg.name) }}_rd_zero;
    (({% if existsIn(blk, "lock_rd") and blk.lock_rd != "" %}{{ sv_lock_expr(blk.lock_rd) }}{% else %}{{ blk.lock_rd_expr_sv }}{% endif %}) && bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> (bus_rdata_o == '0);
  endproperty
  assert_lock_blk_{{ lower(reg.name) }}_rd_zero: assert property (p_lock_blk_{{ lower(reg.name) }}_rd_zero)
    else $error("[SVA] Software read returned non-zero for register {{ reg.name }} while block read-locked!");
{% endfor %}
{% endif %}
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if existsIn(fld, "lock_wr") and fld.lock_wr != "" %}
  property p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable;
    (({{ sv_lock_expr(fld.lock_wr) }}) && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |=> (reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == $past(reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}]));
  endproperty
  assert_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable: assert property (p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable)
    else $error("[SVA] Software write modified field {{ reg.name }}.{{ fld.name }} while field write-locked!");
{% else if existsIn(fld, "lock_wr_expr_sv") and fld.lock_wr_expr_sv != "" %}
  property p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable;
    (({{ fld.lock_wr_expr_sv }}) && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |=> (reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == $past(reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}]));
  endproperty
  assert_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable: assert property (p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_immutable)
    else $error("[SVA] Software write modified field {{ reg.name }}.{{ fld.name }} while field write-locked!");
{% endif %}
{% if existsIn(fld, "lock_rd") and fld.lock_rd != "" %}
  property p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_zero;
    (({{ sv_lock_expr(fld.lock_rd) }}) && bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> (bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == '0);
  endproperty
  assert_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_zero: assert property (p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_zero)
    else $error("[SVA] Software read returned non-zero for field {{ reg.name }}.{{ fld.name }} while field read-locked!");
{% else if existsIn(fld, "lock_rd_expr_sv") and fld.lock_rd_expr_sv != "" %}
  property p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_zero;
    (({{ fld.lock_rd_expr_sv }}) && bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> (bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] == '0);
  endproperty
  assert_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_zero: assert property (p_lock_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_zero)
    else $error("[SVA] Software read returned non-zero for field {{ reg.name }}.{{ fld.name }} while field read-locked!");
{% endif %}
{% endfor %}
{% endfor %}

  // =========================================================================
  // Access Error Response Properties
  // =========================================================================
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "NOACCESS" %}
  property p_err_wr_ro_{{ lower(reg.name) }}_{{ lower(fld.name) }};
    (ERROR_ON_WRITE_TO_RO && bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }}) && (|bus_wstrb_i[{{ byte_end(fld.offset_lsb, fld.size_width) }} : {{ byte_idx(fld.offset_lsb) }}])) |-> bus_error_o;
  endproperty
  assert_err_wr_ro_{{ lower(reg.name) }}_{{ lower(fld.name) }}: assert property (p_err_wr_ro_{{ lower(reg.name) }}_{{ lower(fld.name) }})
    else $error("[SVA] Bus error not asserted on write to RO field {{ reg.name }}.{{ fld.name }}!");
{% endif %}
{% if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
  property p_err_rd_wo_{{ lower(reg.name) }}_{{ lower(fld.name) }};
    (ERROR_ON_READ_FROM_WO && bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }})) |-> bus_error_o;
  endproperty
  assert_err_rd_wo_{{ lower(reg.name) }}_{{ lower(fld.name) }}: assert property (p_err_rd_wo_{{ lower(reg.name) }}_{{ lower(fld.name) }})
    else $error("[SVA] Bus error not asserted on read from WO field {{ reg.name }}.{{ fld.name }}!");
{% endif %}
{% endfor %}
{% endfor %}

endmodule

// =============================================================================
// Standalone SVA Bind Instantiation (Excluded from Synthesis)
// =============================================================================
`ifndef SYNTHESIS
bind {{ lower(blk.name) }}_reg_file {{ lower(blk.name) }}_reg_map_sva #(
  .ADDR_WIDTH(ADDR_WIDTH),
  .DATA_WIDTH(DATA_WIDTH),
  .STRB_WIDTH(STRB_WIDTH),
  .PARAM_HW_PRECEDENCE(PARAM_HW_PRECEDENCE),
  .ERROR_ON_WRITE_TO_RO(ERROR_ON_WRITE_TO_RO),
  .ERROR_ON_READ_FROM_WO(ERROR_ON_READ_FROM_WO),
  .ERROR_ON_WRITE_TO_LOCKED(ERROR_ON_WRITE_TO_LOCKED),
  .ERROR_ON_READ_FROM_LOCKED(ERROR_ON_READ_FROM_LOCKED)
) u_reg_map_sva (
  .clk_i(clk_i),
  .rst_ni(rst_ni),
  .bus_wr_en_i(bus_wr_en_i),
  .bus_rd_en_i(bus_rd_en_i),
  .bus_addr_i(bus_addr_i),
  .bus_wdata_i(bus_wdata_i),
  .bus_wstrb_i(bus_wstrb_i),
  .bus_rdata_o(bus_rdata_o),
  .bus_ready_o(bus_ready_o),
  .bus_error_o(bus_error_o),
{% for reg in blk.registers %}
  .sw_{{ lower(reg.name) }}_wr_strobe_o(sw_{{ lower(reg.name) }}_wr_strobe_o),
  .sw_{{ lower(reg.name) }}_rd_strobe_o(sw_{{ lower(reg.name) }}_rd_strobe_o),
  .reg_{{ lower(reg.name) }}_q(reg_{{ lower(reg.name) }}_q),
{% for fld in reg.fields %}
{% if (existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE") or (upper(fld.access) == "RO" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WO" and upper(fld.hw_access) != "RW" and upper(fld.hw_access) != "W1T" and upper(fld.hw_access) != "INCR" and upper(fld.hw_access) != "DECR"))) %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i),
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i),
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i),
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WIRE" and upper(fld.hw_access) != "WO")) %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i),
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i),
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i),
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i),
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i),
  .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o(hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% endif %}
{% endfor %}
{% endfor %}
{% if existsIn(blk, "lock_signals") and length(blk.lock_signals) > 0 %}
{% for sig in blk.lock_signals %}
  .{{ sig }}({{ sig }}),
{% endfor %}
{% endif %}
  .unused_dummy(1'b0)
);
`endif
{% endfor %}
