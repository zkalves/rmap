{% for blk in blocks %}
-- =============================================================================
-- Entity: {{ lower(blk.name) }}_reg_file
-- Description: Generic Bus-Agnostic Synthesizable VHDL Register File
-- Generated by rmap - Hardware Register Map Designer
-- =============================================================================

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity {{ lower(blk.name) }}_reg_file is
  generic (
    ADDR_WIDTH : integer := 32;
    DATA_WIDTH : integer := {{ reg_width }};
    STRB_WIDTH : integer := {{ reg_width }} / 8;
    PARAM_HW_PRECEDENCE : std_logic := {% if (exists("param_hw_precedence") and (param_hw_precedence == 0 or param_hw_precedence == "0")) or (exists("hw_precedence") and not hw_precedence) %}'0'{% else %}'1'{% endif %}
  );
  port (
    clk_i                     : in  std_logic;
    rst_ni                    : in  std_logic;

    -- Hardware Core Sideband Signals
{% for reg in blk.registers %}
    -- --- Register: {{ reg.name }} (Offset: {{ reg.offset_hex }}) ---
    sw_{{ lower(reg.name) }}_wr_strobe_o : out std_logic;
    sw_{{ lower(reg.name) }}_rd_strobe_o : out std_logic;
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i     : in  std_logic_vector({{ fld.size_width }}-1 downto 0);
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i : in  std_logic_vector({{ fld.size_width }}-1 downto 0);
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     : out std_logic_vector({{ fld.size_width }}-1 downto 0);
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i : in  std_logic_vector({{ fld.size_width }}-1 downto 0);
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     : out std_logic_vector({{ fld.size_width }}-1 downto 0);
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     : out std_logic_vector({{ fld.size_width }}-1 downto 0);
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i  : in  std_logic;
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i : in std_logic_vector({{ fld.size_width }}-1 downto 0);
{% endif %}
{% endfor %}

{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
    -- External Memory Subsystem Passthrough Ports
{% for mem in blk.memories %}
    mem_{{ lower(mem.name) }}_req_o   : out std_logic;
    mem_{{ lower(mem.name) }}_we_o    : out std_logic;
    mem_{{ lower(mem.name) }}_addr_o  : out std_logic_vector(ADDR_WIDTH-1 downto 0);
    mem_{{ lower(mem.name) }}_wdata_o : out std_logic_vector(DATA_WIDTH-1 downto 0);
    mem_{{ lower(mem.name) }}_wstrb_o : out std_logic_vector(STRB_WIDTH-1 downto 0);
    mem_{{ lower(mem.name) }}_rdata_i : in  std_logic_vector(DATA_WIDTH-1 downto 0);
    mem_{{ lower(mem.name) }}_ready_i : in  std_logic;
{% endfor %}
{% endif %}
    -- Protocol Bus Slave Interface
    bus_wr_en_i               : in  std_logic;
    bus_rd_en_i               : in  std_logic;
    bus_addr_i                : in  std_logic_vector(ADDR_WIDTH-1 downto 0);
    bus_wdata_i               : in  std_logic_vector(DATA_WIDTH-1 downto 0);
    bus_wstrb_i               : in  std_logic_vector(STRB_WIDTH-1 downto 0);
    bus_rdata_o               : out std_logic_vector(DATA_WIDTH-1 downto 0);
    bus_ready_o               : out std_logic;
    bus_error_o               : out std_logic
  );
end entity {{ lower(blk.name) }}_reg_file;

architecture rtl of {{ lower(blk.name) }}_reg_file is

  -- Address Offsets
{% for reg in blk.registers %}
  constant ADDR_{{ upper(reg.name) }} : std_logic_vector(ADDR_WIDTH-1 downto 0) := std_logic_vector(to_unsigned({{ reg.offset_lsb }}, ADDR_WIDTH));
{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
{% for mem in blk.memories %}
  constant MEM_{{ upper(mem.name) }}_START : unsigned(ADDR_WIDTH-1 downto 0) := to_unsigned({{ mem.offset_lsb }}, ADDR_WIDTH);
  constant MEM_{{ upper(mem.name) }}_SIZE  : unsigned(ADDR_WIDTH-1 downto 0) := to_unsigned({{ mem.size_width }}, ADDR_WIDTH);
  constant MEM_{{ upper(mem.name) }}_END   : unsigned(ADDR_WIDTH-1 downto 0) := MEM_{{ upper(mem.name) }}_START + MEM_{{ upper(mem.name) }}_SIZE;
  signal mem_{{ lower(mem.name) }}_hit     : std_logic;
{% endfor %}
{% endif %}

  -- Internal Storage
{% for reg in blk.registers %}
  signal reg_{{ lower(reg.name) }}_q, reg_{{ lower(reg.name) }}_d : std_logic_vector(DATA_WIDTH-1 downto 0);
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
  signal reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q, reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d : std_logic;
{% endif %}
{% endfor %}
{% endfor %}

  -- SW Strobes
{% for reg in blk.registers %}
  signal s_sw_{{ lower(reg.name) }}_wr_strobe : std_logic;
  signal s_sw_{{ lower(reg.name) }}_rd_strobe : std_logic;
{% endfor %}

  signal strb_nonzero : std_logic;

begin

  -- Byte strobe nonzero detector
  strb_nonzero <= '0' when bus_wstrb_i = (STRB_WIDTH-1 downto 0 => '0') else '1';

  -- SW Strobe Assignments
{% for reg in blk.registers %}
  s_sw_{{ lower(reg.name) }}_wr_strobe <= '1' when (bus_wr_en_i = '1' and bus_addr_i = ADDR_{{ upper(reg.name) }} and strb_nonzero = '1') else '0';
  s_sw_{{ lower(reg.name) }}_rd_strobe <= '1' when (bus_rd_en_i = '1' and bus_addr_i = ADDR_{{ upper(reg.name) }}) else '0';
  sw_{{ lower(reg.name) }}_wr_strobe_o <= s_sw_{{ lower(reg.name) }}_wr_strobe;
  sw_{{ lower(reg.name) }}_rd_strobe_o <= s_sw_{{ lower(reg.name) }}_rd_strobe;
{% endfor %}

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  -- Memory Window Decode
{% for mem in blk.memories %}
  mem_{{ lower(mem.name) }}_hit     <= '1' when (unsigned(bus_addr_i) >= MEM_{{ upper(mem.name) }}_START and unsigned(bus_addr_i) < MEM_{{ upper(mem.name) }}_END) else '0';
  mem_{{ lower(mem.name) }}_req_o   <= (bus_wr_en_i or bus_rd_en_i) and mem_{{ lower(mem.name) }}_hit;
  mem_{{ lower(mem.name) }}_we_o    <= bus_wr_en_i and mem_{{ lower(mem.name) }}_hit;
  mem_{{ lower(mem.name) }}_addr_o  <= std_logic_vector(unsigned(bus_addr_i) - MEM_{{ upper(mem.name) }}_START) when mem_{{ lower(mem.name) }}_hit = '1' else (others => '0');
  mem_{{ lower(mem.name) }}_wdata_o <= bus_wdata_i;
  mem_{{ lower(mem.name) }}_wstrb_o <= bus_wstrb_i;
{% endfor %}
{% endif %}

  -- Next-State Combinational Logic
{% for reg in blk.registers %}
  proc_{{ lower(reg.name) }}_next : process(reg_{{ lower(reg.name) }}_q,
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
    reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q,
{% endif %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i,
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i, hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i,
{% endif %}
{% endfor %}
    s_sw_{{ lower(reg.name) }}_wr_strobe, s_sw_{{ lower(reg.name) }}_rd_strobe,
    bus_wdata_i, bus_wstrb_i)
    variable v_d : std_logic_vector(DATA_WIDTH-1 downto 0);
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
    variable v_{{ lower(fld.name) }}_written : std_logic;
{% endif %}
{% endfor %}
  begin
    v_d := reg_{{ lower(reg.name) }}_q;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
    v_{{ lower(fld.name) }}_written := reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q;
{% endif %}
{% endfor %}

    if PARAM_HW_PRECEDENCE = '1' then
      -- HW Precedence: SW writes first, HW overrides
      if s_sw_{{ lower(reg.name) }}_wr_strobe = '1' then
        for b in 0 to STRB_WIDTH-1 loop
          if bus_wstrb_i(b) = '1' then
            for bit_idx in b*8 to (b+1)*8-1 loop
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" or upper(fld.access) == "WRC" or upper(fld.access) == "WRS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                v_d(bit_idx) := bus_wdata_i(bit_idx);
              end if;
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W1CRS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '1' then
                  v_d(bit_idx) := '0';
                end if;
              end if;
{% else if upper(fld.access) == "W1S" or upper(fld.access) == "W1SRC" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '1' then
                  v_d(bit_idx) := '1';
                end if;
              end if;
{% else if upper(fld.access) == "W1T" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '1' then
                  v_d(bit_idx) := not reg_{{ lower(reg.name) }}_q(bit_idx);
                end if;
              end if;
{% else if upper(fld.access) == "W0C" or upper(fld.access) == "W0CRS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '0' then
                  v_d(bit_idx) := '0';
                end if;
              end if;
{% else if upper(fld.access) == "W0S" or upper(fld.access) == "W0SRC" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '0' then
                  v_d(bit_idx) := '1';
                end if;
              end if;
{% else if upper(fld.access) == "W0T" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '0' then
                  v_d(bit_idx) := not reg_{{ lower(reg.name) }}_q(bit_idx);
                end if;
              end if;
{% else if upper(fld.access) == "WC" or upper(fld.access) == "WOC" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                v_d(bit_idx) := '0';
              end if;
{% else if upper(fld.access) == "WS" or upper(fld.access) == "WOS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                v_d(bit_idx) := '1';
              end if;
{% else if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if v_{{ lower(fld.name) }}_written = '0' then
                  v_d(bit_idx) := bus_wdata_i(bit_idx);
                  v_{{ lower(fld.name) }}_written := '1';
                end if;
              end if;
{% endif %}
{% endfor %}
            end loop;
          end if;
        end loop;
      end if;

      -- Read Side-Effects
      if s_sw_{{ lower(reg.name) }}_rd_strobe = '1' then
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "WRC" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
        v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := (others => '0');
{% else if upper(fld.access) == "RS" or upper(fld.access) == "WRS" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
        v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := (others => '1');
{% endif %}
{% endfor %}
      end if;

      -- HW Updates (Overrides SW)
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
      v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) or hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
      v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) and not hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i;
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
      if hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i = '1' then
        v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i;
      end if;
{% endif %}
{% endfor %}

    else
      -- SW Precedence: HW updates first, SW overrides
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
      v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) or hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
      v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) and not hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i;
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
      if hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i = '1' then
        v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i;
      end if;
{% endif %}
{% endfor %}

      if s_sw_{{ lower(reg.name) }}_wr_strobe = '1' then
        for b in 0 to STRB_WIDTH-1 loop
          if bus_wstrb_i(b) = '1' then
            for bit_idx in b*8 to (b+1)*8-1 loop
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" or upper(fld.access) == "WRC" or upper(fld.access) == "WRS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                v_d(bit_idx) := bus_wdata_i(bit_idx);
              end if;
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W1CRS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '1' then
                  v_d(bit_idx) := '0';
                end if;
              end if;
{% else if upper(fld.access) == "W1S" or upper(fld.access) == "W1SRC" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '1' then
                  v_d(bit_idx) := '1';
                end if;
              end if;
{% else if upper(fld.access) == "W1T" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '1' then
                  v_d(bit_idx) := not reg_{{ lower(reg.name) }}_q(bit_idx);
                end if;
              end if;
{% else if upper(fld.access) == "W0C" or upper(fld.access) == "W0CRS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '0' then
                  v_d(bit_idx) := '0';
                end if;
              end if;
{% else if upper(fld.access) == "W0S" or upper(fld.access) == "W0SRC" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '0' then
                  v_d(bit_idx) := '1';
                end if;
              end if;
{% else if upper(fld.access) == "W0T" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if bus_wdata_i(bit_idx) = '0' then
                  v_d(bit_idx) := not reg_{{ lower(reg.name) }}_q(bit_idx);
                end if;
              end if;
{% else if upper(fld.access) == "WC" or upper(fld.access) == "WOC" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                v_d(bit_idx) := '0';
              end if;
{% else if upper(fld.access) == "WS" or upper(fld.access) == "WOS" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                v_d(bit_idx) := '1';
              end if;
{% else if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
              if bit_idx >= {{ fld.offset_lsb }} and bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }}) then
                if v_{{ lower(fld.name) }}_written = '0' then
                  v_d(bit_idx) := bus_wdata_i(bit_idx);
                  v_{{ lower(fld.name) }}_written := '1';
                end if;
              end if;
{% endif %}
{% endfor %}
            end loop;
          end if;
        end loop;
      end if;

      if s_sw_{{ lower(reg.name) }}_rd_strobe = '1' then
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "WRC" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
        v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := (others => '0');
{% else if upper(fld.access) == "RS" or upper(fld.access) == "WRS" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
        v_d({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) := (others => '1');
{% endif %}
{% endfor %}
      end if;
    end if;

    reg_{{ lower(reg.name) }}_d <= v_d;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
    reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d <= v_{{ lower(fld.name) }}_written;
{% endif %}
{% endfor %}
  end process proc_{{ lower(reg.name) }}_next;

{% endfor %}

  -- Sequential Register Process
  proc_reg_seq : process(clk_i, rst_ni)
  begin
    if rst_ni = '0' then
{% for reg in blk.registers %}
      reg_{{ lower(reg.name) }}_q <= std_logic_vector(to_unsigned({{ reg.reset_val }}, DATA_WIDTH));
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
      reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q <= '0';
{% endif %}
{% endfor %}
{% endfor %}
    elsif rising_edge(clk_i) then
{% for reg in blk.registers %}
      reg_{{ lower(reg.name) }}_q <= reg_{{ lower(reg.name) }}_d;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
      reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q <= reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d;
{% endif %}
{% endfor %}
{% endfor %}
    end if;
  end process proc_reg_seq;

  -- Read Decode Process
  proc_read_decode : process(bus_rd_en_i, bus_wr_en_i, bus_addr_i,
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
{% for mem in blk.memories %}
    mem_{{ lower(mem.name) }}_hit, mem_{{ lower(mem.name) }}_rdata_i, mem_{{ lower(mem.name) }}_ready_i,
{% endfor %}
{% endif %}
{% for reg in blk.registers %}
    reg_{{ lower(reg.name) }}_q,
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% endif %}
{% endfor %}
{% endfor %}
    rst_ni)
  begin
    bus_rdata_o <= (others => '0');
    bus_ready_o <= bus_wr_en_i or bus_rd_en_i;
    bus_error_o <= '0';

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
    if bus_rd_en_i = '1' or bus_wr_en_i = '1' then
{% for mem in blk.memories %}
      if mem_{{ lower(mem.name) }}_hit = '1' then
        bus_rdata_o <= mem_{{ lower(mem.name) }}_rdata_i;
        bus_ready_o <= mem_{{ lower(mem.name) }}_ready_i;
        bus_error_o <= '0';
      else
{% endfor %}
        case bus_addr_i is
{% for reg in blk.registers %}
          when ADDR_{{ upper(reg.name) }} =>
            bus_ready_o <= '1';
            if bus_rd_en_i = '1' then
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and existsIn(fld, "hw_access") and upper(fld.hw_access) == "NA" %}
              bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= std_logic_vector(to_unsigned({{ fld.reset_val }}, {{ fld.size_width }}));
{% else if upper(fld.access) == "RO" %}
              bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
              bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= (others => '0');
{% else %}
              bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= reg_{{ lower(reg.name) }}_q({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }});
{% endif %}
{% endfor %}
            end if;
{% endfor %}
          when others =>
            bus_rdata_o <= (others => '0');
            bus_ready_o <= '1';
            bus_error_o <= '1';
        end case;
{% for mem in blk.memories %}
      end if;
{% endfor %}
    end if;
{% else %}
    if bus_rd_en_i = '1' or bus_wr_en_i = '1' then
      case bus_addr_i is
{% for reg in blk.registers %}
        when ADDR_{{ upper(reg.name) }} =>
          if bus_rd_en_i = '1' then
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and existsIn(fld, "hw_access") and upper(fld.hw_access) == "NA" %}
            bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= std_logic_vector(to_unsigned({{ fld.reset_val }}, {{ fld.size_width }}));
{% else if upper(fld.access) == "RO" %}
            bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
            bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= (others => '0');
{% else %}
            bus_rdata_o({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }}) <= reg_{{ lower(reg.name) }}_q({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }});
{% endif %}
{% endfor %}
          end if;
{% endfor %}
        when others =>
          bus_rdata_o <= (others => '0');
          bus_error_o <= '1';
      end case;
    end if;
{% endif %}
  end process proc_read_decode;

  -- Output Signal Assignments
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" %}
  hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o <= reg_{{ lower(reg.name) }}_q({{ fld.offset_lsb }} + {{ fld.size_width }} - 1 downto {{ fld.offset_lsb }});
{% endif %}
{% endfor %}
{% endfor %}

end architecture rtl;
{% endfor %}
