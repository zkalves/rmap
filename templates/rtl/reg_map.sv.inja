{% for blk in blocks %}
// =============================================================================
// Module: {{ lower(blk.name) }}_reg_file
// Description: Generic Bus-Agnostic Synthesizable Register File
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

timeunit 1ns;
timeprecision 1ps;

module {{ lower(blk.name) }}_reg_file #(
  parameter int ADDR_WIDTH = 32,
  parameter int DATA_WIDTH = {{ reg_width }},
  parameter int STRB_WIDTH = DATA_WIDTH / 8,
  parameter bit PARAM_HW_PRECEDENCE = {% if exists("param_hw_precedence") %}{{ param_hw_precedence }}{% else if exists("hw_precedence") and hw_precedence %}1{% else %}1{% endif %}
)(
  input  logic                      clk_i,
  input  logic                      rst_ni,

  // Hardware Core Sideband Signals
{% for reg in blk.registers %}
  // --- Register: {{ reg.name }} (Offset: {{ reg.offset_hex }}) ---
  output logic                      sw_{{ lower(reg.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_rd_strobe_o,
{% for fld in reg.fields %}
  output logic                      sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o,
{% if (existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE") or (upper(fld.access) == "RO" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WO" and upper(fld.hw_access) != "RW" and upper(fld.hw_access) != "W1T" and upper(fld.hw_access) != "INCR" and upper(fld.hw_access) != "DECR"))) %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% else if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WIRE" and upper(fld.hw_access) != "WO")) %}
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i,
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
  input  logic                      hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% endfor %}

{% endfor %}

{% if existsIn(blk, "lock_signals") and length(blk.lock_signals) > 0 %}
  // Hardware Write-Lock Control Input Ports (deduplicated)
{% for sig in blk.lock_signals %}
  input  logic                      {{ sig }},
{% endfor %}
{% endif %}

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // External Memory Subsystem Passthrough Ports
{% for mem in blk.memories %}
  // --- Memory: {{ mem.name }} (Offset: {{ mem.offset_hex }}, Size: {{ mem.size_width }} B) ---
  output logic                      mem_{{ lower(mem.name) }}_req_o,
  output logic                      mem_{{ lower(mem.name) }}_we_o,
  output logic [ADDR_WIDTH-1:0]     mem_{{ lower(mem.name) }}_addr_o,
  output logic [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wdata_o,
  output logic [STRB_WIDTH-1:0]     mem_{{ lower(mem.name) }}_wstrb_o,
  input  logic [DATA_WIDTH-1:0]     mem_{{ lower(mem.name) }}_rdata_i,
  input  logic                      mem_{{ lower(mem.name) }}_ready_i,
{% endfor %}
{% endif %}
  // Protocol Bus Slave Interface (Protocol-Independent)
  input  logic                      bus_wr_en_i,
  input  logic                      bus_rd_en_i,
  input  logic [ADDR_WIDTH-1:0]     bus_addr_i,
  input  logic [DATA_WIDTH-1:0]     bus_wdata_i,
  input  logic [STRB_WIDTH-1:0]     bus_wstrb_i,
  output logic [DATA_WIDTH-1:0]     bus_rdata_o,
  output logic                      bus_ready_o,
  output logic                      bus_error_o
);

  // =========================================================================
  // Register & Memory Address Offsets
  // =========================================================================
{% for reg in blk.registers %}
  localparam logic [ADDR_WIDTH-1:0] ADDR_{{ upper(reg.name) }} = {{ sv_hex(reg.offset_hex, 32) }};
{% endfor %}
{% if existsIn(blk, "crc32_hex") %}
  localparam logic [31:0] REGMAP_CRC32 = {{ sv_hex(blk.crc32_hex, 32) }};
{% endif %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // Memory Window Address Parameters
{% for mem in blk.memories %}
  localparam logic [ADDR_WIDTH-1:0] MEM_{{ upper(mem.name) }}_START = {{ sv_hex(mem.offset_hex, 32) }};
  localparam logic [ADDR_WIDTH-1:0] MEM_{{ upper(mem.name) }}_SIZE  = {{ mem.size_width }};
  localparam logic [ADDR_WIDTH-1:0] MEM_{{ upper(mem.name) }}_END   = MEM_{{ upper(mem.name) }}_START + MEM_{{ upper(mem.name) }}_SIZE;
{% endfor %}

  // Memory Window Hit and Passthrough Logic
{% for mem in blk.memories %}
  logic mem_{{ lower(mem.name) }}_hit;
  assign mem_{{ lower(mem.name) }}_hit     = (bus_addr_i >= MEM_{{ upper(mem.name) }}_START) && (bus_addr_i < MEM_{{ upper(mem.name) }}_END);
  assign mem_{{ lower(mem.name) }}_req_o   = (bus_wr_en_i | bus_rd_en_i) & mem_{{ lower(mem.name) }}_hit;
  assign mem_{{ lower(mem.name) }}_we_o    = bus_wr_en_i & mem_{{ lower(mem.name) }}_hit;
  assign mem_{{ lower(mem.name) }}_addr_o  = mem_{{ lower(mem.name) }}_hit ? (bus_addr_i - MEM_{{ upper(mem.name) }}_START) : '0;
  assign mem_{{ lower(mem.name) }}_wdata_o = bus_wdata_i;
  assign mem_{{ lower(mem.name) }}_wstrb_o = bus_wstrb_i;
{% endfor %}
{% endif %}

  // =========================================================================
  // Internal Register Storage Declarations
  // =========================================================================
{% for reg in blk.registers %}
  logic [DATA_WIDTH-1:0] reg_{{ lower(reg.name) }}_q, reg_{{ lower(reg.name) }}_d;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q, reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d;
{% endif %}
{% endfor %}
{% endfor %}

  // =========================================================================
  // Software Read / Write Lock Signals
  // =========================================================================
{% if (existsIn(blk, "lock_wr") and blk.lock_wr != "") or (existsIn(blk, "lock_wr_expr_sv") and blk.lock_wr_expr_sv != "") %}
  logic blk_wr_locked;
  assign blk_wr_locked = ({% if existsIn(blk, "lock_wr") and blk.lock_wr != "" %}{{ sv_lock_expr(blk.lock_wr) }}{% else %}{{ blk.lock_wr_expr_sv }}{% endif %});
{% else %}
  wire blk_wr_locked = 1'b0;
{% endif %}
{% if (existsIn(blk, "lock_rd") and blk.lock_rd != "") or (existsIn(blk, "lock_rd_expr_sv") and blk.lock_rd_expr_sv != "") %}
  logic blk_rd_locked;
  assign blk_rd_locked = ({% if existsIn(blk, "lock_rd") and blk.lock_rd != "" %}{{ sv_lock_expr(blk.lock_rd) }}{% else %}{{ blk.lock_rd_expr_sv }}{% endif %});
{% else %}
  wire blk_rd_locked = 1'b0;
{% endif %}
{% for reg in blk.registers %}
{% if existsIn(reg, "lock_wr") and reg.lock_wr != "" %}
  logic reg_{{ lower(reg.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_wr_locked = ({{ sv_lock_expr(reg.lock_wr) }}) || blk_wr_locked;
  logic reg_{{ lower(reg.name) }}_locked;
  assign reg_{{ lower(reg.name) }}_locked = reg_{{ lower(reg.name) }}_wr_locked;
{% else if existsIn(reg, "lock_wr_expr_sv") and reg.lock_wr_expr_sv != "" %}
  logic reg_{{ lower(reg.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_wr_locked = ({{ reg.lock_wr_expr_sv }}) || blk_wr_locked;
  logic reg_{{ lower(reg.name) }}_locked;
  assign reg_{{ lower(reg.name) }}_locked = reg_{{ lower(reg.name) }}_wr_locked;
{% else if existsIn(reg, "lock_expr_sv") and reg.lock_expr_sv != "" %}
  logic reg_{{ lower(reg.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_wr_locked = ({{ reg.lock_expr_sv }}) || blk_wr_locked;
  logic reg_{{ lower(reg.name) }}_locked;
  assign reg_{{ lower(reg.name) }}_locked = reg_{{ lower(reg.name) }}_wr_locked;
{% else %}
  logic reg_{{ lower(reg.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_wr_locked = blk_wr_locked;
  logic reg_{{ lower(reg.name) }}_locked;
  assign reg_{{ lower(reg.name) }}_locked = blk_wr_locked;
{% endif %}
{% if existsIn(reg, "lock_rd") and reg.lock_rd != "" %}
  logic reg_{{ lower(reg.name) }}_rd_locked;
  assign reg_{{ lower(reg.name) }}_rd_locked = ({{ sv_lock_expr(reg.lock_rd) }}) || blk_rd_locked;
{% else if existsIn(reg, "lock_rd_expr_sv") and reg.lock_rd_expr_sv != "" %}
  logic reg_{{ lower(reg.name) }}_rd_locked;
  assign reg_{{ lower(reg.name) }}_rd_locked = ({{ reg.lock_rd_expr_sv }}) || blk_rd_locked;
{% else %}
  logic reg_{{ lower(reg.name) }}_rd_locked;
  assign reg_{{ lower(reg.name) }}_rd_locked = blk_rd_locked;
{% endif %}
{% for fld in reg.fields %}
{% if existsIn(fld, "lock_wr") and fld.lock_wr != "" %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked = ({{ sv_lock_expr(fld.lock_wr) }}) || reg_{{ lower(reg.name) }}_wr_locked;
{% else if existsIn(fld, "lock_wr_expr_sv") and fld.lock_wr_expr_sv != "" %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked = ({{ fld.lock_wr_expr_sv }}) || reg_{{ lower(reg.name) }}_wr_locked;
{% else %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked;
  assign reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked = reg_{{ lower(reg.name) }}_wr_locked;
{% endif %}
{% if existsIn(fld, "lock_rd") and fld.lock_rd != "" %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked;
  assign reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked = ({{ sv_lock_expr(fld.lock_rd) }}) || reg_{{ lower(reg.name) }}_rd_locked;
{% else if existsIn(fld, "lock_rd_expr_sv") and fld.lock_rd_expr_sv != "" %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked;
  assign reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked = ({{ fld.lock_rd_expr_sv }}) || reg_{{ lower(reg.name) }}_rd_locked;
{% else %}
  logic reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked;
  assign reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked = reg_{{ lower(reg.name) }}_rd_locked;
{% endif %}
{% endfor %}
{% endfor %}

  // =========================================================================
  // SW Read / Write Strobe Generation
  // =========================================================================
{% for reg in blk.registers %}
  assign sw_{{ lower(reg.name) }}_wr_strobe_o = bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }}) && (|bus_wstrb_i) && !reg_{{ lower(reg.name) }}_wr_locked;
  assign sw_{{ lower(reg.name) }}_rd_strobe_o = bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }}) && !reg_{{ lower(reg.name) }}_rd_locked;
{% for fld in reg.fields %}
  assign sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_strobe_o = bus_wr_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }}) && (|bus_wstrb_i) && !reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked;
  assign sw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_strobe_o = bus_rd_en_i && (bus_addr_i == ADDR_{{ upper(reg.name) }}) && !reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked;
{% endfor %}
{% endfor %}

  // =========================================================================
  // Register Next-State Logic & Hardware Updates
  // =========================================================================
{% for reg in blk.registers %}
  always_comb begin : proc_{{ lower(reg.name) }}_next
    reg_{{ lower(reg.name) }}_d = reg_{{ lower(reg.name) }}_q;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
    reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d = reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q;
{% endif %}
{% endfor %}

    if (PARAM_HW_PRECEDENCE) begin
      // ---------------------------------------------------------------------
      // HW Precedence: SW access evaluated first, HW updates override
      // ---------------------------------------------------------------------
      // 1. SW Write Update
      if (sw_{{ lower(reg.name) }}_wr_strobe_o{% if (existsIn(reg, "lock_wr") and reg.lock_wr != "") or (existsIn(reg, "lock_wr_expr_sv") and reg.lock_wr_expr_sv != "") %} && !reg_{{ lower(reg.name) }}_wr_locked{% else if existsIn(reg, "lock_expr_sv") and reg.lock_expr_sv != "" %} && !reg_{{ lower(reg.name) }}_locked{% endif %}) begin
        for (int b = 0; b < STRB_WIDTH; b++) begin
          if (bus_wstrb_i[b]) begin
            for (int bit_idx = b * 8; bit_idx < (b + 1) * 8; bit_idx++) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" or upper(fld.access) == "WRC" or upper(fld.access) == "WRS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
              end
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W1CRS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W1S" or upper(fld.access) == "W1SRC" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W1T" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "W0C" or upper(fld.access) == "W0CRS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W0S" or upper(fld.access) == "W0SRC" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W0T" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "WC" or upper(fld.access) == "WOC" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
              end
{% else if upper(fld.access) == "WS" or upper(fld.access) == "WOS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
              end
{% else if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
                  reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d = 1'b1;
                end
              end
{% endif %}
{% endfor %}
            end
          end
        end
      end

      // 2. SW Read Side-Effects (RC, RS, WRC, WRS, W1SRC, W1CRS, W0SRC, W0CRS)
      if (sw_{{ lower(reg.name) }}_rd_strobe_o) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "WRC" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
        if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked) begin
          reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
        end
{% else if upper(fld.access) == "RS" or upper(fld.access) == "WRS" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
        if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked) begin
          reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '1;
        end
{% endif %}
{% endfor %}
      end

      // 3. Hardware Updates (Override SW)
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] |= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
      end
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] &= ~hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i;
      end
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i;
      end
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] ^= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i;
      end
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] + 1'b1;
      end
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] - 1'b1;
      end
{% endif %}
{% endfor %}

    end else begin
      // ---------------------------------------------------------------------
      // SW Precedence: HW updates evaluated first, SW access overrides
      // ---------------------------------------------------------------------
      // 1. Hardware Updates
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "RS" or upper(fld.access) == "WC" or upper(fld.access) == "W1C" or upper(fld.access) == "W0C" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] |= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
      end
{% endif %}
{% if upper(fld.access) == "WS" or upper(fld.access) == "W1S" or upper(fld.access) == "W0S" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] &= ~hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_clr_i;
      end
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wd_i;
      end
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "W1T" %}
      if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] ^= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_tog_i;
      end
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "INCR" %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_incr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] + 1'b1;
      end
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "DECR" %}
      if (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_decr_i) begin
        reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] - 1'b1;
      end
{% endif %}
{% endfor %}

      // 2. SW Write Update (Overrides HW)
      if (sw_{{ lower(reg.name) }}_wr_strobe_o{% if (existsIn(reg, "lock_wr") and reg.lock_wr != "") or (existsIn(reg, "lock_wr_expr_sv") and reg.lock_wr_expr_sv != "") %} && !reg_{{ lower(reg.name) }}_wr_locked{% else if existsIn(reg, "lock_expr_sv") and reg.lock_expr_sv != "" %} && !reg_{{ lower(reg.name) }}_locked{% endif %}) begin
        for (int b = 0; b < STRB_WIDTH; b++) begin
          if (bus_wstrb_i[b]) begin
            for (int bit_idx = b * 8; bit_idx < (b + 1) * 8; bit_idx++) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" or upper(fld.access) == "WRC" or upper(fld.access) == "WRS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
              end
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W1CRS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W1S" or upper(fld.access) == "W1SRC" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W1T" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "W0C" or upper(fld.access) == "W0CRS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
                end
              end
{% else if upper(fld.access) == "W0S" or upper(fld.access) == "W0SRC" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
                end
              end
{% else if upper(fld.access) == "W0T" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!bus_wdata_i[bit_idx]) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = ~reg_{{ lower(reg.name) }}_q[bit_idx];
                end
              end
{% else if upper(fld.access) == "WC" or upper(fld.access) == "WOC" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b0;
              end
{% else if upper(fld.access) == "WS" or upper(fld.access) == "WOS" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                reg_{{ lower(reg.name) }}_d[bit_idx] = 1'b1;
              end
{% else if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
              if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wr_locked && bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
                if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q) begin
                  reg_{{ lower(reg.name) }}_d[bit_idx] = bus_wdata_i[bit_idx];
                  reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d = 1'b1;
                end
              end
{% endif %}
{% endfor %}
            end
          end
        end
      end

      // 3. SW Read Side-Effects (Overrides HW)
      if (sw_{{ lower(reg.name) }}_rd_strobe_o) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RC" or upper(fld.access) == "WRC" or upper(fld.access) == "W1SRC" or upper(fld.access) == "W0SRC" %}
        if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked) begin
          reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
        end
{% else if upper(fld.access) == "RS" or upper(fld.access) == "WRS" or upper(fld.access) == "W1CRS" or upper(fld.access) == "W0CRS" %}
        if (!reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked) begin
          reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '1;
        end
{% endif %}
{% endfor %}
      end
    end
  end

{% endfor %}

  // =========================================================================
  // Sequential Register Instantiation
  // =========================================================================
  always_ff @(posedge clk_i or negedge rst_ni) begin : proc_reg_seq
    if (!rst_ni) begin
{% for reg in blk.registers %}
{% if existsIn(reg, "reset_hex") %}
      reg_{{ lower(reg.name) }}_q <= {{ sv_hex(reg.reset_val, reg_width) }};
{% else %}
      reg_{{ lower(reg.name) }}_q <= '0;
{% endif %}
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
      reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q <= 1'b0;
{% endif %}
{% endfor %}
{% endfor %}
    end else begin
{% for reg in blk.registers %}
      reg_{{ lower(reg.name) }}_q <= reg_{{ lower(reg.name) }}_d;
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1" or upper(fld.access) == "WO1" %}
      reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_q <= reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_written_d;
{% endif %}
{% endfor %}
{% endfor %}
    end
  end

  // =========================================================================
  // Bus Read Decode Logic
  // =========================================================================
  always_comb begin : proc_read_decode
    bus_rdata_o = '0;
    bus_ready_o = bus_wr_en_i | bus_rd_en_i; // Single-cycle response
    bus_error_o = 1'b0;

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
    if (bus_rd_en_i || bus_wr_en_i) begin
      case (1'b1)
{% for mem in blk.memories %}
        mem_{{ lower(mem.name) }}_hit: begin
          bus_rdata_o = mem_{{ lower(mem.name) }}_rdata_i;
          bus_ready_o = mem_{{ lower(mem.name) }}_ready_i;
          bus_error_o = 1'b0;
        end
{% endfor %}
        default: begin
          case (bus_addr_i)
{% for reg in blk.registers %}
            ADDR_{{ upper(reg.name) }}: begin
              bus_ready_o = 1'b1;
              if (bus_rd_en_i) begin
{% if (existsIn(reg, "lock_rd") and reg.lock_rd != "") or (existsIn(reg, "lock_rd_expr_sv") and reg.lock_rd_expr_sv != "") or (existsIn(blk, "lock_rd") and blk.lock_rd != "") or (existsIn(blk, "lock_rd_expr_sv") and blk.lock_rd_expr_sv != "") %}
                if (reg_{{ lower(reg.name) }}_rd_locked) begin
                  bus_rdata_o = '0;
                end else begin
{% endif %}
{% for fld in reg.fields %}
{% if (existsIn(fld, "lock_rd") and fld.lock_rd != "") or (existsIn(fld, "lock_rd_expr_sv") and fld.lock_rd_expr_sv != "") %}
                if (reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked) begin
                  bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
                end else begin
{% endif %}
{% if upper(fld.access) == "RO" and existsIn(fld, "hw_access") and upper(fld.hw_access) == "NA" %}
                bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {{ sv_hex(fld.reset_val, fld.size_width) }};
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE" %}
                bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "RO" %}
                bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
                bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
{% else %}
                bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% if (existsIn(fld, "lock_rd") and fld.lock_rd != "") or (existsIn(fld, "lock_rd_expr_sv") and fld.lock_rd_expr_sv != "") %}
                end
{% endif %}
{% endfor %}
{% if (existsIn(reg, "lock_rd") and reg.lock_rd != "") or (existsIn(reg, "lock_rd_expr_sv") and reg.lock_rd_expr_sv != "") or (existsIn(blk, "lock_rd") and blk.lock_rd != "") or (existsIn(blk, "lock_rd_expr_sv") and blk.lock_rd_expr_sv != "") %}
                end
{% endif %}
              end
            end
{% endfor %}
            default: begin
              bus_rdata_o = '0;
              bus_ready_o = 1'b1;
              bus_error_o = 1'b1;
            end
          endcase
        end
      endcase
    end
{% else %}
    if (bus_rd_en_i || bus_wr_en_i) begin
      case (bus_addr_i)
{% for reg in blk.registers %}
        ADDR_{{ upper(reg.name) }}: begin
          if (bus_rd_en_i) begin
{% if (existsIn(reg, "lock_rd") and reg.lock_rd != "") or (existsIn(reg, "lock_rd_expr_sv") and reg.lock_rd_expr_sv != "") or (existsIn(blk, "lock_rd") and blk.lock_rd != "") or (existsIn(blk, "lock_rd_expr_sv") and blk.lock_rd_expr_sv != "") %}
            if (reg_{{ lower(reg.name) }}_rd_locked) begin
              bus_rdata_o = '0;
            end else begin
{% endif %}
{% for fld in reg.fields %}
{% if (existsIn(fld, "lock_rd") and fld.lock_rd != "") or (existsIn(fld, "lock_rd_expr_sv") and fld.lock_rd_expr_sv != "") %}
            if (reg_{{ lower(reg.name) }}_{{ lower(fld.name) }}_rd_locked) begin
              bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
            end else begin
{% endif %}
{% if upper(fld.access) == "RO" and existsIn(fld, "hw_access") and upper(fld.hw_access) == "NA" %}
            bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = {{ sv_hex(fld.reset_val, fld.size_width) }};
{% else if existsIn(fld, "hw_access") and upper(fld.hw_access) == "WIRE" %}
            bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "RO" %}
            bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" or upper(fld.access) == "WO1" or upper(fld.access) == "WOC" or upper(fld.access) == "WOS" or upper(fld.access) == "NOACCESS" %}
            bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
{% else %}
            bus_rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% if (existsIn(fld, "lock_rd") and fld.lock_rd != "") or (existsIn(fld, "lock_rd_expr_sv") and fld.lock_rd_expr_sv != "") %}
            end
{% endif %}
{% endfor %}
{% if (existsIn(reg, "lock_rd") and reg.lock_rd != "") or (existsIn(reg, "lock_rd_expr_sv") and reg.lock_rd_expr_sv != "") or (existsIn(blk, "lock_rd") and blk.lock_rd != "") or (existsIn(blk, "lock_rd_expr_sv") and blk.lock_rd_expr_sv != "") %}
            end
{% endif %}
          end
        end
{% endfor %}
        default: begin
          bus_rdata_o = '0;
          bus_error_o = 1'b1;
        end
      endcase
    end
{% endif %}
  end

  // Output Signal Assignments
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) != "RO" and upper(fld.access) != "NOACCESS" and (not existsIn(fld, "hw_access") or (upper(fld.hw_access) != "NA" and upper(fld.hw_access) != "WIRE" and upper(fld.hw_access) != "WO")) %}
  assign hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% else if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "W1T" or upper(fld.hw_access) == "INCR" or upper(fld.hw_access) == "DECR") %}
  assign hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
{% endfor %}

endmodule
{% endfor %}
