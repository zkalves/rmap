{% for blk in blocks %}
# =============================================================================
# Standalone pyuvm + Cocotb Testbench
# Peripheral: {{ blk.name }}
# Generated by rmap - Hardware Register Map Designer
# =============================================================================

import os
import cocotb
from cocotb.triggers import RisingEdge, Timer
from cocotb.clock import Clock
import pyuvm
from pyuvm import (
    uvm_sequence_item,
    uvm_driver,
    uvm_monitor,
    uvm_sequencer,
    uvm_agent,
    uvm_env,
    uvm_test,
    uvm_sequence,
    uvm_analysis_port,
    uvm_root,
    ConfigDB,
)

# =============================================================================
# 1. Bus Sequence Item
# =============================================================================
class RegBusItem(uvm_sequence_item):
    def __init__(self, name="RegBusItem"):
        super().__init__(name)
        self.addr = 0
        self.data = 0
        self.strb = (1 << ({{ reg_width }} // 8)) - 1
        self.is_read = False
        self.rdata = 0

    def __str__(self):
        op = "READ" if self.is_read else "WRITE"
        return f"{op} addr=0x{self.addr:08x} data=0x{self.data:08x} strb=0x{self.strb:x} rdata=0x{self.rdata:08x}"


# =============================================================================
# 2. Bus Driver
# =============================================================================
class RegBusDriver(uvm_driver):
    def __init__(self, name, parent):
        super().__init__(name, parent)
        self.dut = None

    def build_phase(self):
        self.dut = ConfigDB().get(self, "", "DUT")

    async def run_phase(self):
        # Default idle bus state
        self.dut.wr_en_i.value = 0
        self.dut.rd_en_i.value = 0
        self.dut.addr_i.value = 0
        self.dut.wdata_i.value = 0
        self.dut.wstrb_i.value = 0

        while True:
            item = await self.seq_item_port.get_next_item()
            await RisingEdge(self.dut.clk_i)

            if item.is_read:
                self.dut.rd_en_i.value = 1
                self.dut.wr_en_i.value = 0
                self.dut.addr_i.value = item.addr
                self.dut.wstrb_i.value = 0
                await RisingEdge(self.dut.clk_i)
                while int(self.dut.ready_o.value) == 0:
                    await RisingEdge(self.dut.clk_i)
                item.rdata = int(self.dut.rdata_o.value)
                self.dut.rd_en_i.value = 0
            else:
                self.dut.wr_en_i.value = 1
                self.dut.rd_en_i.value = 0
                self.dut.addr_i.value = item.addr
                self.dut.wdata_i.value = item.data
                self.dut.wstrb_i.value = item.strb
                await RisingEdge(self.dut.clk_i)
                while int(self.dut.ready_o.value) == 0:
                    await RisingEdge(self.dut.clk_i)
                self.dut.wr_en_i.value = 0
                self.dut.wstrb_i.value = 0

            self.seq_item_port.item_done()


# =============================================================================
# 3. Bus Monitor
# =============================================================================
class RegBusMonitor(uvm_monitor):
    def __init__(self, name, parent):
        super().__init__(name, parent)
        self.dut = None
        self.ap = uvm_analysis_port("ap", self)

    def build_phase(self):
        self.dut = ConfigDB().get(self, "", "DUT")

    async def run_phase(self):
        while True:
            await RisingEdge(self.dut.clk_i)
            if int(self.dut.ready_o.value) == 1:
                item = RegBusItem("mon_item")
                item.addr = int(self.dut.addr_i.value)
                if int(self.dut.wr_en_i.value) == 1:
                    item.is_read = False
                    item.data = int(self.dut.wdata_i.value)
                    item.strb = int(self.dut.wstrb_i.value)
                    self.ap.write(item)
                elif int(self.dut.rd_en_i.value) == 1:
                    item.is_read = True
                    item.rdata = int(self.dut.rdata_o.value)
                    self.ap.write(item)


# =============================================================================
# 4. Agent & Environment
# =============================================================================
class RegBusAgent(uvm_agent):
    def build_phase(self):
        self.sequencer = uvm_sequencer("sequencer", self)
        self.driver = RegBusDriver("driver", self)
        self.monitor = RegBusMonitor("monitor", self)

    def connect_phase(self):
        self.driver.seq_item_port.connect(self.sequencer.seq_item_export)


class RegEnv(uvm_env):
    def build_phase(self):
        self.agent = RegBusAgent("agent", self)


# =============================================================================
# 5. UVM Register Test Sequences (IEEE 1800.2 Equivalents)
# =============================================================================

# -----------------------------------------------------------------------------
# 5.1. Hardware Reset Sequence (uvm_reg_hw_reset_seq)
# -----------------------------------------------------------------------------
class HwResetCheckSequence(uvm_sequence):
    """
    Equivalent to IEEE 1800.2 uvm_reg_hw_reset_seq:
    Reads every register in the block without prior writes and checks that its
    initial state exactly matches the hardware reset value.
    """
    async def body(self):
        self.logger.info("--- [pyuvm] Starting Hardware Reset Sequence (uvm_reg_hw_reset_seq) ---")
{% for reg in blk.registers %}
        item = RegBusItem("read_{{ lower(reg.name) }}")
        item.addr = {{ reg.offset_hex }}
        item.is_read = True
        await self.start_item(item)
        await self.finish_item(item)
        expected = {{ reg.reset_hex }}
        assert item.rdata == expected, (
            f"Reset mismatch for {{ reg.name }} at addr {{ reg.offset_hex }}: "
            f"expected 0x{expected:08x}, got 0x{item.rdata:08x}"
        )
        self.logger.info(f"  [PASS] {{ reg.name }}: reset value verified (0x{item.rdata:08x})")
{% endfor %}
        self.logger.info("--- [pyuvm] Hardware Reset Sequence Completed Successfully ---")


# -----------------------------------------------------------------------------
# 5.2. Bit-Bash Sequence (uvm_reg_bit_bash_seq)
# -----------------------------------------------------------------------------
class BitBashSequence(uvm_sequence):
    """
    Equivalent to IEEE 1800.2 uvm_reg_bit_bash_seq:
    Systematically toggles ('bashes') every individual bit position in each register
    to verify complete bit independence:
    - RW bits must toggle 0 -> 1 and 1 -> 0.
    - RO bits must remain unaffected by bus writes.
    - Neighboring bits must not be unintentionally altered.
    """
    async def write_reg(self, addr, val):
        item = RegBusItem("write")
        item.addr = addr
        item.data = val
        item.strb = (1 << ({{ reg_width }} // 8)) - 1
        item.is_read = False
        await self.start_item(item)
        await self.finish_item(item)

    async def read_reg(self, addr):
        item = RegBusItem("read")
        item.addr = addr
        item.is_read = True
        await self.start_item(item)
        await self.finish_item(item)
        return item.rdata

    async def body(self):
        self.logger.info("--- [pyuvm] Starting Bit-Bash Sequence (uvm_reg_bit_bash_seq) ---")
{% for reg in blk.registers %}
        self.logger.info(f"  Bashing register: {{ reg.name }} (addr {{ reg.offset_hex }})")
        rw_mask = 0
        ro_mask = 0
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" %}
        rw_mask |= (((1 << {{ fld.size_width }}) - 1) << {{ fld.offset_lsb }})
{% else if upper(fld.access) == "RO" %}
        ro_mask |= (((1 << {{ fld.size_width }}) - 1) << {{ fld.offset_lsb }})
{% endif %}
{% endfor %}

        # Read baseline value
        v0 = await self.read_reg({{ reg.offset_hex }})

        for b in range({{ reg_width }}):
            bit_mask = 1 << b
            # Write inverted bit
            bash_val = v0 ^ bit_mask
            await self.write_reg({{ reg.offset_hex }}, bash_val)
            v1 = await self.read_reg({{ reg.offset_hex }})

            if (bit_mask & rw_mask) != 0:
                expected_bit = (bash_val >> b) & 1
                actual_bit = (v1 >> b) & 1
                assert actual_bit == expected_bit, (
                    f"Bit-bash failed for {{ reg.name }} bit {b}: expected {expected_bit}, got {actual_bit}"
                )
            elif (bit_mask & ro_mask) != 0:
                expected_bit = (v0 >> b) & 1
                actual_bit = (v1 >> b) & 1
                assert actual_bit == expected_bit, (
                    f"Bit-bash RO violation for {{ reg.name }} bit {b}: expected {expected_bit}, got {actual_bit}"
                )

            # Restore baseline value
            await self.write_reg({{ reg.offset_hex }}, v0)

        self.logger.info(f"  [PASS] {{ reg.name }} bit-bash completed.")
{% endfor %}
        self.logger.info("--- [pyuvm] Bit-Bash Sequence Completed Successfully ---")


# -----------------------------------------------------------------------------
# 5.3. Register Access Sequence (uvm_reg_access_seq)
# -----------------------------------------------------------------------------
class RegisterRwSequence(uvm_sequence):
    """
    Equivalent to IEEE 1800.2 uvm_reg_access_seq:
    Applies walking bit patterns and checkerboard words (0x55, 0xAA, 0xFF, 0x00)
    to all registers to verify field extraction and access policies.
    """
    async def body(self):
        self.logger.info("--- [pyuvm] Starting Register Access Sequence (uvm_reg_access_seq) ---")
{% for reg in blk.registers %}
        patterns = [0x5A5A5A5A, 0xA5A5A5A5, 0xFFFFFFFF, 0x00000000]
        for pattern in patterns:
            item_wr = RegBusItem("wr_{{ lower(reg.name) }}")
            item_wr.addr = {{ reg.offset_hex }}
            item_wr.data = pattern & ((1 << {{ reg_width }}) - 1)
            item_wr.strb = (1 << ({{ reg_width }} // 8)) - 1
            item_wr.is_read = False
            await self.start_item(item_wr)
            await self.finish_item(item_wr)

            item_rd = RegBusItem("rd_{{ lower(reg.name) }}")
            item_rd.addr = {{ reg.offset_hex }}
            item_rd.is_read = True
            await self.start_item(item_rd)
            await self.finish_item(item_rd)

{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" %}
            fld_mask = (1 << {{ fld.size_width }}) - 1
            expected_fld = (pattern >> {{ fld.offset_lsb }}) & fld_mask
            actual_fld = (item_rd.rdata >> {{ fld.offset_lsb }}) & fld_mask
            assert actual_fld == expected_fld, (
                f"Pattern 0x{pattern:x} access failed for {{ reg.name }}.{{ fld.name }}: "
                f"expected 0x{expected_fld:x}, got 0x{actual_fld:x}"
            )
{% endif %}
{% endfor %}
        self.logger.info(f"  [PASS] {{ reg.name }} access patterns verified.")
{% endfor %}
        self.logger.info("--- [pyuvm] Register Access Sequence Completed Successfully ---")


# =============================================================================
# 6. UVM Tests
# =============================================================================
class PyUvmHwResetTest(uvm_test):
    """Executes only the uvm_reg_hw_reset_seq sequence."""
    def build_phase(self):
        self.env = RegEnv("env", self)

    async def run_phase(self):
        self.raise_objection()
        dut = ConfigDB().get(self, "", "DUT")
        dut.rst_ni.value = 0
        await Timer(50, units="ns")
        dut.rst_ni.value = 1
        await Timer(20, units="ns")

        seq = HwResetCheckSequence("reset_seq")
        await seq.start(self.env.agent.sequencer)
        self.drop_objection()


class PyUvmBitBashTest(uvm_test):
    """Executes only the uvm_reg_bit_bash_seq sequence."""
    def build_phase(self):
        self.env = RegEnv("env", self)

    async def run_phase(self):
        self.raise_objection()
        dut = ConfigDB().get(self, "", "DUT")
        dut.rst_ni.value = 0
        await Timer(50, units="ns")
        dut.rst_ni.value = 1
        await Timer(20, units="ns")

        seq = BitBashSequence("bitbash_seq")
        await seq.start(self.env.agent.sequencer)
        self.drop_objection()


class PyUvmRegisterTest(uvm_test):
    """
    Comprehensive regression test running the complete suite of standard UVM register checks:
    1. uvm_reg_hw_reset_seq (Reset Verification)
    2. uvm_reg_bit_bash_seq (Bit Independence Bashing)
    3. uvm_reg_access_seq   (Walking & Alternating Access Patterns)
    """
    def build_phase(self):
        self.env = RegEnv("env", self)

    async def run_phase(self):
        self.raise_objection()
        dut = ConfigDB().get(self, "", "DUT")

        # Power-on Reset
        dut.rst_ni.value = 0
        await Timer(50, units="ns")
        dut.rst_ni.value = 1
        await Timer(20, units="ns")

        # 1. Hardware Reset Sequence
        reset_seq = HwResetCheckSequence("reset_seq")
        await reset_seq.start(self.env.agent.sequencer)

        # 2. Bit-Bash Sequence
        bitbash_seq = BitBashSequence("bitbash_seq")
        await bitbash_seq.start(self.env.agent.sequencer)

        # 3. Register Access Sequence
        rw_seq = RegisterRwSequence("rw_seq")
        await rw_seq.start(self.env.agent.sequencer)

        self.logger.info("=== ALL PYUVM REGISTER SEQUENCES (RESET, BIT-BASH, ACCESS) PASSED SUCCESSFULLY ===")
        self.drop_objection()


# =============================================================================
# Cocotb Entry Point
# =============================================================================
@cocotb.test()
async def run_testbench(dut):
    """Cocotb test entry point driving pyuvm register verification."""
    cocotb.start_soon(Clock(dut.clk_i, 10, units="ns").start())
    ConfigDB().set(None, "*", "DUT", dut)
    test_name = os.environ.get("PYUVM_TEST", "PyUvmRegisterTest")
    await uvm_root().run_test(test_name)
{% endfor %}
