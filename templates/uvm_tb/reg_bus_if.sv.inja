// =============================================================================
// Generic Bus Interface for UVM Register Verification
// Compliant with IEEE 1800.2 (uvm-ieee)
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

interface reg_bus_if #(
  parameter int ADDR_WIDTH = 32,
  parameter int DATA_WIDTH = {{ reg_width }},
  localparam int STRB_WIDTH = DATA_WIDTH / 8
)(
  input logic clk,
  input logic rst_n
);

  // Bus Signals
  logic                  wr_en;
  logic                  rd_en;
  logic [ADDR_WIDTH-1:0] addr;
  logic [DATA_WIDTH-1:0] wdata;
  logic [STRB_WIDTH-1:0] wstrb;
  logic [DATA_WIDTH-1:0] rdata;
  logic                  ready;

  // Clocking block for synchronous master driver
  clocking mck @(posedge clk);
    default input #1ps output #1ps;
    output wr_en;
    output rd_en;
    output addr;
    output wdata;
    output wstrb;
    input  rdata;
    input  ready;
  endclocking

  // Clocking block for synchronous monitor
  clocking mck_mon @(posedge clk);
    default input #1ps;
    input wr_en;
    input rd_en;
    input addr;
    input wdata;
    input wstrb;
    input rdata;
    input ready;
  endclocking

  // Modport for Driver
  modport master_mp (
    clocking mck,
    input clk,
    input rst_n
  );

  // Modport for Monitor
  modport monitor_mp (
    clocking mck_mon,
    input clk,
    input rst_n
  );

  // Modport for DUT Slave
  modport slave_mp (
    input  clk,
    input  rst_n,
    input  wr_en,
    input  rd_en,
    input  addr,
    input  wdata,
    input  wstrb,
    output rdata,
    output ready
  );

endinterface : reg_bus_if
