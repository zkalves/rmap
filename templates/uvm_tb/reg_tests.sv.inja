endclass : {{ lower(blk.name) }}_bit_bash_test


// =============================================================================
// 4. IEEE 1800.2 Standard Register Access Test (uvm_reg_access_seq)
// =============================================================================
class {{ lower(blk.name) }}_reg_access_test extends {{ lower(blk.name) }}_base_test;
  `uvm_component_utils({{ lower(blk.name) }}_reg_access_test)

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual task run_phase(uvm_phase phase);
    uvm_reg_access_seq seq;
    phase.raise_objection(this);

    `uvm_info("TEST", "Starting IEEE 1800.2 uvm_reg_access_seq...", UVM_LOW)
    seq = uvm_reg_access_seq::type_id::create("seq");
    seq.model = env.reg_model;
    seq.start(null);

    `uvm_info("TEST", "Completed IEEE 1800.2 uvm_reg_access_seq successfully!", UVM_LOW)
    phase.drop_objection(this);
