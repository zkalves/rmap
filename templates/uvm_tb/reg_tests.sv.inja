{% for blk in blocks %}
// =============================================================================
// UVM Test Suite for Register Map Verification
// Compatible with UVM 1.1d, UVM 1.2, IEEE 1800.2-2017, and IEEE 1800.2-2020
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

`ifndef {{ upper(blk.name) }}_REG_TESTS_SV
`define {{ upper(blk.name) }}_REG_TESTS_SV

`include "uvm_macros.svh"
import uvm_pkg::*;
import reg_bus_pkg::*;

// =============================================================================
// 1. Base Test
// =============================================================================
class {{ lower(blk.name) }}_base_test extends uvm_test;
  `uvm_component_utils({{ lower(blk.name) }}_base_test)

  {{ lower(blk.name) }}_reg_env env;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    env = {{ lower(blk.name) }}_reg_env::type_id::create("env", this);
  endfunction

  virtual function void end_of_elaboration_phase(uvm_phase phase);
    super.end_of_elaboration_phase(phase);
    `uvm_info("UVM_VER", $sformatf("Active UVM library: %s", uvm_revision_string()), UVM_NONE)
    uvm_top.print_topology();
  endfunction
endclass : {{ lower(blk.name) }}_base_test


// =============================================================================
// 2. IEEE 1800.2 Standard HW Reset Test (uvm_reg_hw_reset_seq)
// =============================================================================
class {{ lower(blk.name) }}_hw_reset_test extends {{ lower(blk.name) }}_base_test;
  `uvm_component_utils({{ lower(blk.name) }}_hw_reset_test)

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual task run_phase(uvm_phase phase);
    uvm_reg_hw_reset_seq seq;
    phase.raise_objection(this);

    `uvm_info("TEST", "Starting uvm_reg_hw_reset_seq...", UVM_LOW)
    seq = uvm_reg_hw_reset_seq::type_id::create("seq");
    seq.model = env.reg_model;
    seq.start(null);

    `uvm_info("TEST", "Completed uvm_reg_hw_reset_seq successfully!", UVM_LOW)
    phase.drop_objection(this);
  endtask
endclass : {{ lower(blk.name) }}_hw_reset_test


