// =============================================================================
// Generic UVM Bus VIP Package
// Compliant with IEEE 1800.2 (uvm-ieee)
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

package reg_bus_pkg;

  import uvm_pkg::*;
  `include "uvm_macros.svh"

  typedef enum bit {
    BUS_READ  = 1'b0,
    BUS_WRITE = 1'b1
  } bus_op_e;

  // ===========================================================================
  // 1. Bus Sequence Item
  // ===========================================================================
  class reg_bus_item extends uvm_sequence_item;
    rand bit [31:0]           addr;
    rand bit [{{ reg_width }}-1:0] data;
    rand bit [({{ reg_width }}/8)-1:0] strb;
    rand bus_op_e             op;
    bit [{{ reg_width }}-1:0]      rdata;
    bit                       error;

    `uvm_object_utils_begin(reg_bus_item)
      `uvm_field_int(addr,  UVM_ALL_ON | UVM_HEX)
      `uvm_field_int(data,  UVM_ALL_ON | UVM_HEX)
      `uvm_field_int(strb,  UVM_ALL_ON | UVM_HEX)
      `uvm_field_enum(bus_op_e, op, UVM_ALL_ON)
      `uvm_field_int(rdata, UVM_ALL_ON | UVM_HEX)
      `uvm_field_int(error, UVM_ALL_ON)
    `uvm_object_utils_end

    function new(string name = "reg_bus_item");
      super.new(name);
      this.strb = '1;
    endfunction
  endclass : reg_bus_item

  // ===========================================================================
  // 2. Bus Driver
  // ===========================================================================
  class reg_bus_driver extends uvm_driver #(reg_bus_item);
    `uvm_component_utils(reg_bus_driver)

    virtual reg_bus_if vif;

    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction

    virtual function void build_phase(uvm_phase phase);
      super.build_phase(phase);
      if (!uvm_config_db #(virtual reg_bus_if)::get(this, "", "vif", vif)) begin
        `uvm_fatal("NO_VIF", "Virtual interface not set for reg_bus_driver")
      end
    endfunction

    virtual task run_phase(uvm_phase phase);
      // Initialize bus lines to idle
      vif.mck.wr_en <= 1'b0;
      vif.mck.rd_en <= 1'b0;
      vif.mck.addr  <= '0;
      vif.mck.wdata <= '0;
      vif.mck.wstrb <= '0;

      forever begin
        seq_item_port.get_next_item(req);
        drive_transfer(req);
        seq_item_port.item_done();
      end
    endtask

    virtual task drive_transfer(reg_bus_item tr);
      @(vif.mck);
      if (tr.op == BUS_WRITE) begin
        vif.mck.wr_en <= 1'b1;
        vif.mck.rd_en <= 1'b0;
        vif.mck.addr  <= tr.addr;
        vif.mck.wdata <= tr.data;
        vif.mck.wstrb <= tr.strb;
      end else begin
        vif.mck.wr_en <= 1'b0;
        vif.mck.rd_en <= 1'b1;
        vif.mck.addr  <= tr.addr;
        vif.mck.wstrb <= '0;
      end

      @(vif.mck);
      while (!vif.mck.ready) @(vif.mck);

      if (tr.op == BUS_READ) begin
        tr.rdata = vif.mck.rdata;
      end

      vif.mck.wr_en <= 1'b0;
      vif.mck.rd_en <= 1'b0;
      vif.mck.wstrb <= '0;
    endtask
  endclass : reg_bus_driver

  // ===========================================================================
  // 3. Bus Monitor
  // ===========================================================================
  class reg_bus_monitor extends uvm_monitor;
    `uvm_component_utils(reg_bus_monitor)

    virtual reg_bus_if vif;
    uvm_analysis_port #(reg_bus_item) ap;

    function new(string name, uvm_component parent);
      super.new(name, parent);
      ap = new("ap", this);
    endfunction

    virtual function void build_phase(uvm_phase phase);
      super.build_phase(phase);
      if (!uvm_config_db #(virtual reg_bus_if)::get(this, "", "vif", vif)) begin
        `uvm_fatal("NO_VIF", "Virtual interface not set for reg_bus_monitor")
      end
    endfunction

    virtual task run_phase(uvm_phase phase);
      forever begin
        @(vif.mck_mon);
        if (vif.mck_mon.ready && (vif.mck_mon.wr_en || vif.mck_mon.rd_en)) begin
          reg_bus_item item = reg_bus_item::type_id::create("mon_item");
          item.addr = vif.mck_mon.addr;
          if (vif.mck_mon.wr_en) begin
            item.op    = BUS_WRITE;
            item.data  = vif.mck_mon.wdata;
            item.strb  = vif.mck_mon.wstrb;
          end else begin
            item.op    = BUS_READ;
            item.rdata = vif.mck_mon.rdata;
          end
          ap.write(item);
        end
      end
    endtask
  endclass : reg_bus_monitor

  // Sequencer definition
  typedef uvm_sequencer #(reg_bus_item) reg_bus_sequencer;

  // ===========================================================================
  // 4. Bus Agent
  // ===========================================================================
  class reg_bus_agent extends uvm_agent;
    `uvm_component_utils(reg_bus_agent)

    reg_bus_driver    driver;
    reg_bus_monitor   monitor;
    reg_bus_sequencer sequencer;

    function new(string name, uvm_component parent);
      super.new(name, parent);
    endfunction

    virtual function void build_phase(uvm_phase phase);
      super.build_phase(phase);
      monitor = reg_bus_monitor::type_id::create("monitor", this);
      if (get_is_active() == UVM_ACTIVE) begin
        driver    = reg_bus_driver::type_id::create("driver", this);
        sequencer = reg_bus_sequencer::type_id::create("sequencer", this);
      end
    endfunction

    virtual function void connect_phase(uvm_phase phase);
      super.connect_phase(phase);
      if (get_is_active() == UVM_ACTIVE) begin
        driver.seq_item_port.connect(sequencer.seq_item_export);
      end
    endfunction
  endclass : reg_bus_agent

  // ===========================================================================
  // 5. UVM Register Adapter (IEEE 1800.2 compliant)
  // ===========================================================================
  class reg_bus_adapter extends uvm_reg_adapter;
    `uvm_object_utils(reg_bus_adapter)

    function new(string name = "reg_bus_adapter");
      super.new(name);
      supports_byte_enable = 1;
      provides_responses   = 0;
    endfunction

    virtual function uvm_sequence_item reg2bus(const ref uvm_reg_bus_op rw);
      reg_bus_item item = reg_bus_item::type_id::create("adapter_item");
      item.op   = (rw.kind == UVM_WRITE) ? BUS_WRITE : BUS_READ;
      item.addr = rw.addr;
      item.data = rw.data;
      item.strb = rw.byte_en;
      return item;
    endfunction

    virtual function void bus2reg(uvm_sequence_item bus_item, ref uvm_reg_bus_op rw);
      reg_bus_item item;
      if (!$cast(item, bus_item)) begin
        `uvm_fatal("ADAPTER_CAST_FAIL", "Failed to cast bus_item to reg_bus_item")
        return;
      end
      rw.kind   = (item.op == BUS_WRITE) ? UVM_WRITE : UVM_READ;
      rw.addr   = item.addr;
      rw.data   = (item.op == BUS_WRITE) ? item.data : item.rdata;
      rw.status = UVM_IS_OK;
    endfunction
  endclass : reg_bus_adapter

endpackage : reg_bus_pkg
