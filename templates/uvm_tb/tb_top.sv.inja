{% for blk in blocks %}
// =============================================================================
// Top-Level UVM Testbench Module
// Compliant with IEEE 1800.2 (uvm-ieee)
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

module tb_top;

  import uvm_pkg::*;
  `include "uvm_macros.svh"

  import reg_bus_pkg::*;

  // Clock & Reset Signals
  logic clk;
  logic rst_n;

  // Clock Generation (100 MHz)
  initial begin
    clk = 1'b0;
    forever #5 clk = ~clk;
  end

  // Reset Generation
  initial begin
    rst_n = 1'b0;
    #25 rst_n = 1'b1;
  end

  // Bus Interface Instance
  reg_bus_if #(
    .ADDR_WIDTH(32),
    .DATA_WIDTH({{ reg_width }})
  ) bus_if (
    .clk(clk),
    .rst_n(rst_n)
  );

  // Sideband Hardware Signals
{% for reg in blk.registers %}
  logic sw_{{ lower(reg.name) }}_wr_strobe;
  logic sw_{{ lower(reg.name) }}_rd_strobe;
{% for fld in reg.fields %}
{% if (upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS") and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_in = '0;
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set = '0;
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out;
{% else if upper(fld.access) != "RO" %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out;
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  logic                            hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_in = '0;
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_in = '0;
{% endif %}
{% endfor %}
{% endfor %}

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // Memory Passthrough Signals
{% for mem in blk.memories %}
  logic                    mem_{{ lower(mem.name) }}_req;
  logic                    mem_{{ lower(mem.name) }}_we;
  logic [31:0]             mem_{{ lower(mem.name) }}_addr;
  logic [{{ reg_width }}-1:0] mem_{{ lower(mem.name) }}_wdata;
  logic [({{ reg_width }}/8)-1:0] mem_{{ lower(mem.name) }}_wstrb;
  logic [{{ reg_width }}-1:0] mem_{{ lower(mem.name) }}_rdata = '0;
  logic                    mem_{{ lower(mem.name) }}_ready = 1'b1;
{% endfor %}
{% endif %}

  // DUT Instantiation
  {{ lower(blk.name) }}_reg_file #(
    .ADDR_WIDTH(32),
    .DATA_WIDTH({{ reg_width }})
  ) dut (
    .clk_i                     (clk),
    .rst_ni                    (rst_n),
{% for reg in blk.registers %}
    .sw_{{ lower(reg.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_wr_strobe),
    .sw_{{ lower(reg.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_rd_strobe),
{% for fld in reg.fields %}
{% if (upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS") and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_in),
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out),
{% else if upper(fld.access) != "RO" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out),
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i  (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_in),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_in),
{% endif %}
{% endfor %}
{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
{% for mem in blk.memories %}
    .mem_{{ lower(mem.name) }}_req_o   (mem_{{ lower(mem.name) }}_req),
    .mem_{{ lower(mem.name) }}_we_o    (mem_{{ lower(mem.name) }}_we),
    .mem_{{ lower(mem.name) }}_addr_o  (mem_{{ lower(mem.name) }}_addr),
    .mem_{{ lower(mem.name) }}_wdata_o (mem_{{ lower(mem.name) }}_wdata),
    .mem_{{ lower(mem.name) }}_wstrb_o (mem_{{ lower(mem.name) }}_wstrb),
    .mem_{{ lower(mem.name) }}_rdata_i (mem_{{ lower(mem.name) }}_rdata),
    .mem_{{ lower(mem.name) }}_ready_i (mem_{{ lower(mem.name) }}_ready),
{% endfor %}
{% endif %}
    .bus_wr_en_i               (bus_if.wr_en),
    .bus_rd_en_i               (bus_if.rd_en),
    .bus_addr_i                (bus_if.addr),
    .bus_wdata_i               (bus_if.wdata),
    .bus_wstrb_i               (bus_if.wstrb),
    .bus_rdata_o               (bus_if.rdata),
    .bus_ready_o               (bus_if.ready),
    .bus_error_o               ()
  );

  // UVM Test Execution
  initial begin
    uvm_config_db #(virtual reg_bus_if)::set(null, "*", "vif", bus_if);
    run_test();
  end

endmodule : tb_top
{% endfor %}
