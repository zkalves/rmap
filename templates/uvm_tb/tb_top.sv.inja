{% for blk in blocks %}
// =============================================================================
// Top-Level UVM Testbench Module
// Compliant with IEEE 1800.2 (uvm-ieee)
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

module tb_top;

  import uvm_pkg::*;
  `include "uvm_macros.svh"

  import reg_bus_pkg::*;

  // Clock & Reset Signals
  logic clk;
  logic rst_n;

  // Clock Generation (100 MHz)
  initial begin
    clk = 1'b0;
    forever #5 clk = ~clk;
  end

  // Reset Generation
  initial begin
    rst_n = 1'b0;
    #25 rst_n = 1'b1;
  end

  // Bus Interface Instance
  reg_bus_if #(
    .ADDR_WIDTH(32),
    .DATA_WIDTH({{ reg_width }})
  ) bus_if (
    .clk(clk),
    .rst_n(rst_n)
  );

  // Sideband Hardware Signals
{% for reg in blk.registers %}
  logic sw_{{ lower(reg.name) }}_wr_strobe;
  logic sw_{{ lower(reg.name) }}_rd_strobe;
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS" %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_in = '0;
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set = '0;
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out;
{% else %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out;
{% endif %}
{% endfor %}
{% endfor %}
  logic irq_out;

  // DUT Instantiation
  {{ lower(blk.name) }}_reg_file #(
    .ADDR_WIDTH(32),
    .DATA_WIDTH({{ reg_width }})
  ) dut (
    .clk_i                     (clk),
    .rst_ni                    (rst_n),
    .wr_en_i                   (bus_if.wr_en),
    .rd_en_i                   (bus_if.rd_en),
    .addr_i                    (bus_if.addr),
    .wdata_i                   (bus_if.wdata),
    .wstrb_i                   (bus_if.wstrb),
    .rdata_o                   (bus_if.rdata),
    .ready_o                   (bus_if.ready),
    .irq_o                     (irq_out),
{% for reg in blk.registers %}
    .sw_{{ lower(reg.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_wr_strobe),
    .sw_{{ lower(reg.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_rd_strobe),
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_in),
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out),
{% else %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_out),
{% endif %}
{% endfor %}
{% endfor %}
    .irq_o                     (irq_out)
  );

  // UVM Test Execution
  initial begin
    uvm_config_db #(virtual reg_bus_if)::set(null, "*", "vif", bus_if);
    run_test();
  end

endmodule : tb_top
{% endfor %}
