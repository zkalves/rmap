{% for blk in blocks %}
// =============================================================================
// UVM Verification Environment
// Peripheral: {{ blk.name }}
// Compatible with UVM 1.1d, UVM 1.2, IEEE 1800.2-2017, and IEEE 1800.2-2020
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

`ifndef {{ upper(blk.name) }}_REG_ENV_SV
`define {{ upper(blk.name) }}_REG_ENV_SV

`include "uvm_macros.svh"
import uvm_pkg::*;
import reg_bus_pkg::*;

class {{ lower(blk.name) }}_reg_env extends uvm_env;
  `uvm_component_utils({{ lower(blk.name) }}_reg_env)

  reg_bus_pkg::reg_bus_agent                      agent;
  reg_bus_pkg::reg_bus_adapter                    adapter;
  uvm_reg_predictor #(reg_bus_pkg::reg_bus_item)  predictor;
  {{ lower(blk.name) }}_reg_block                 reg_model;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    // Instantiate Bus Agent
    agent = reg_bus_pkg::reg_bus_agent::type_id::create("agent", this);

    // Instantiate Register Model
    reg_model = {{ lower(blk.name) }}_reg_block::type_id::create("reg_model");
    reg_model.build();
    reg_model.lock_model();

    // Instantiate Adapter and Predictor
    adapter   = reg_bus_pkg::reg_bus_adapter::type_id::create("adapter");
    predictor = uvm_reg_predictor #(reg_bus_pkg::reg_bus_item)::type_id::create("predictor", this);
  endfunction

  virtual function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);

    // Connect Register Model map to Agent Sequencer & Adapter
    reg_model.default_map.set_sequencer(agent.sequencer, adapter);
    reg_model.default_map.set_auto_predict(0);

    // Connect Monitor analysis port to Predictor
    predictor.map     = reg_model.default_map;
    predictor.adapter = adapter;
    agent.monitor.ap.connect(predictor.bus_in);
  endfunction
endclass : {{ lower(blk.name) }}_reg_env

`endif // {{ upper(blk.name) }}_REG_ENV_SV
{% endfor %}
