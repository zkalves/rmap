{% for blk in blocks %}
// =============================================================================
// Module: {{ lower(blk.name) }}_reg_file
// Description: Generic Bus-Agnostic Synthesizable Register File
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

timeunit 1ns;
timeprecision 1ps;

module {{ lower(blk.name) }}_reg_file #(
  parameter int ADDR_WIDTH = 32,
  parameter int DATA_WIDTH = {{ reg_width }},
  localparam int STRB_WIDTH = DATA_WIDTH / 8
)(
  input  logic                      clk_i,
  input  logic                      rst_ni,

  // Generic Bus Slave Interface
  input  logic                      wr_en_i,
  input  logic                      rd_en_i,
  input  logic [ADDR_WIDTH-1:0]     addr_i,
  input  logic [DATA_WIDTH-1:0]     wdata_i,
  input  logic [STRB_WIDTH-1:0]     wstrb_i,
  output logic [DATA_WIDTH-1:0]     rdata_o,
  output logic                      ready_o,

  // Hardware Sideband Signals
{% for reg in blk.registers %}
  // --- Register: {{ reg.name }} (Offset: {{ reg.offset_hex }}) ---
  output logic                      sw_{{ lower(reg.name) }}_wr_strobe_o,
  output logic                      sw_{{ lower(reg.name) }}_rd_strobe_o,
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i,
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
  input  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i,
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% else %}
  output logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o,
{% endif %}
{% endfor %}

{% endfor %}
  // Interrupt Output
  output logic                      irq_o
);

  // =========================================================================
  // Register Address Offsets
  // =========================================================================
{% for reg in blk.registers %}
  localparam logic [ADDR_WIDTH-1:0] ADDR_{{ upper(reg.name) }} = {{ reg.offset_hex }};
{% endfor %}

  // =========================================================================
  // Internal Register Storage Declarations
  // =========================================================================
{% for reg in blk.registers %}
  logic [DATA_WIDTH-1:0] reg_{{ lower(reg.name) }}_q, reg_{{ lower(reg.name) }}_d;
{% endfor %}

  // =========================================================================
  // SW Read / Write Strobe Generation
  // =========================================================================
{% for reg in blk.registers %}
  assign sw_{{ lower(reg.name) }}_wr_strobe_o = wr_en_i && (addr_i == ADDR_{{ upper(reg.name) }});
  assign sw_{{ lower(reg.name) }}_rd_strobe_o = rd_en_i && (addr_i == ADDR_{{ upper(reg.name) }});
{% endfor %}

  // =========================================================================
  // Register Next-State Logic & Hardware Updates
  // =========================================================================
{% for reg in blk.registers %}
  always_comb begin : proc_{{ lower(reg.name) }}_next
    reg_{{ lower(reg.name) }}_d = reg_{{ lower(reg.name) }}_q;

    // SW Write Update
    if (sw_{{ lower(reg.name) }}_wr_strobe_o) begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" or upper(fld.access) == "WO" %}
      for (int b = 0; b < STRB_WIDTH; b++) begin
        if (wstrb_i[b]) begin
          // Byte-enabled write update
          for (int bit_idx = b * 8; bit_idx < (b + 1) * 8; bit_idx++) begin
            if (bit_idx >= {{ fld.offset_lsb }} && bit_idx < ({{ fld.offset_lsb }} + {{ fld.size_width }})) begin
              reg_{{ lower(reg.name) }}_d[bit_idx] = wdata_i[bit_idx];
            end
          end
        end
      end
{% else if upper(fld.access) == "W1C" %}
      // Write-1-to-Clear update
      reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = 
        reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] & ~wdata_i[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% else if upper(fld.access) == "W1S" %}
      // Write-1-to-Set update
      reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = 
        reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}] | wdata_i[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
    end

    // Hardware Update Precedence
{% for fld in reg.fields %}
{% if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
    if (|hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i) begin
      reg_{{ lower(reg.name) }}_d[{{ fld.offset_lsb }} +: {{ fld.size_width }}] |= hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
    end
{% endif %}
{% endfor %}
  end

{% endfor %}

  // =========================================================================
  // Sequential Register Instantiation
  // =========================================================================
  always_ff @(posedge clk_i or negedge rst_ni) begin : proc_reg_seq
    if (!rst_ni) begin
{% for reg in blk.registers %}
{% if existsIn(reg, "reset_hex") %}
      reg_{{ lower(reg.name) }}_q <= {{ reg.reset_hex }};
{% else %}
      reg_{{ lower(reg.name) }}_q <= '0;
{% endif %}
{% endfor %}
    end else begin
{% for reg in blk.registers %}
      reg_{{ lower(reg.name) }}_q <= reg_{{ lower(reg.name) }}_d;
{% endfor %}
    end
  end

  // =========================================================================
  // Bus Read Decode Logic
  // =========================================================================
  always_comb begin : proc_read_decode
    rdata_o = '0;
    ready_o = wr_en_i | rd_en_i; // Single-cycle response
    if (rd_en_i) begin
      case (addr_i)
{% for reg in blk.registers %}
        ADDR_{{ upper(reg.name) }}: begin
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS" %}
          rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "WO" %}
          rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = '0;
{% else %}
          rdata_o[{{ fld.offset_lsb }} +: {{ fld.size_width }}] = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
        end
{% endfor %}
        default: begin
          rdata_o = '0;
        end
      endcase
    end
  end

  // Output Signal Assignments
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) != "RO" and upper(fld.access) != "RC" and upper(fld.access) != "RS" %}
  assign hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o = reg_{{ lower(reg.name) }}_q[{{ fld.offset_lsb }} +: {{ fld.size_width }}];
{% endif %}
{% endfor %}
{% endfor %}

  assign irq_o = 1'b0;

endmodule
{% endfor %}
