// =============================================================================
// File: {{ snake_case(name) }}_map.rdl
// Description: SystemRDL 2.0 Register Map Specification
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

addrmap {{ snake_case(name) }} {
    name = "{{ name }}";
    desc = "{{ description }}";
    default regwidth = {{ reg_width }};
    default sw = rw;
    default hw = r;

{% for blk in blocks %}
    // =========================================================================
    // Block: {{ blk.name }} (Base Offset: {{ blk.offset_hex }})
    // =========================================================================
    regfile {{ lower(blk.name) }}_rf {
        name = "{{ blk.name }}";
{% if blk.description != "" %}
        desc = "{{ blk.description }}";
{% endif %}

{% for reg in blk.registers %}
        // --- Register: {{ reg.name }} @ {{ reg.offset_hex }} ---
        reg {{ lower(reg.name) }}_reg_t {
            name = "{{ reg.name }}";
{% if reg.description != "" %}
            desc = "{{ reg.description }}";
{% endif %}
            default sw = {{ lower(reg.access) }};

{% for fld in reg.fields %}
            field {
                name = "{{ fld.name }}";
{% if fld.description != "" %}
                desc = "{{ fld.description }}";
{% endif %}
                sw = {{ lower(fld.access) }};
                hw = {{ lower(fld.hw_access) }};
{% if fld.volatile %}
                volatile = true;
{% endif %}
{% if fld.has_reset %}
                reset = {{ fld.size_width }}'h{{ to_hex(fld.reset_val, 1) }};
{% endif %}
            } {{ lower(fld.name) }}[{{ msb(fld.size_width, fld.offset_lsb) }}:{{ fld.offset_lsb }}]{% if fld.has_reset %} = {{ fld.size_width }}'h{{ to_hex(fld.reset_val, 1) }}{% endif %};

{% endfor %}
        } {{ lower(reg.name) }} @ {{ reg.offset_hex }};

{% endfor %}
    } {{ lower(blk.name) }} @ {{ blk.offset_hex }};

{% endfor %}
};
