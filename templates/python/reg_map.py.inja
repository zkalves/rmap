# =============================================================================
# Python Register Map Definitions & Lab Bring-Up Driver
# Generated by rmap - Hardware Register Map Designer
# Compatible with Cocotb, PyUVM, PySerial, PyFTDI, and JTAG testbenches
# =============================================================================

from typing import Dict, Any, Callable

class Field:
    def __init__(self, name: str, lsb: int, width: int, access: str, reset: int, desc: str = ""):
        self.name = name
        self.lsb = lsb
        self.width = width
        self.mask = ((1 << width) - 1) << lsb
        self.access = access
        self.reset = reset
        self.desc = desc

    def get(self, reg_val: int) -> int:
        return (reg_val & self.mask) >> self.lsb

    def set(self, reg_val: int, field_val: int) -> int:
        return (reg_val & ~self.mask) | ((field_val << self.lsb) & self.mask)


class Register:
    def __init__(self, name: str, offset: int, width: int = 32, desc: str = "", fields: Dict[str, Field] = None):
        self.name = name
        self.offset = offset
        self.width = width
        self.desc = desc
        self.fields = fields or {}

{% for blk in blocks %}
class {{ blk.name }}Block:
    """Register Block: {{ blk.name }}"""
    def __init__(self, base_addr: int = 0, read_fn: Callable[[int], int] = None, write_fn: Callable[[int, int], None] = None):
        self.base_addr = base_addr
        self.read_fn = read_fn
        self.write_fn = write_fn

{% for reg in blk.registers %}
        # {{ reg.name }} (Offset: {{ reg.offset_hex }})
        self.{{ lower(reg.name) }} = Register("{{ reg.name }}", {{ reg.offset_hex }}, {{ reg.size_width }}, "{{ reg.description }}", {
{% for fld in reg.fields %}
            "{{ fld.name }}": Field("{{ fld.name }}", {{ fld.offset_lsb }}, {{ fld.size_width }}, "{{ fld.access }}", {{ fld.reset_hex }}, "{{ fld.description }}"),
{% endfor %}
        })
{% endfor %}

    def read_reg(self, reg: Register) -> int:
        if self.read_fn is None:
            raise RuntimeError("Read callback not registered")
        return self.read_fn(self.base_addr + reg.offset)

    def write_reg(self, reg: Register, value: int) -> None:
        if self.write_fn is None:
            raise RuntimeError("Write callback not registered")
        self.write_fn(self.base_addr + reg.offset, value)

    def read_field(self, reg: Register, field_name: str) -> int:
        reg_val = self.read_reg(reg)
        return reg.fields[field_name].get(reg_val)

    def write_field(self, reg: Register, field_name: str, value: int) -> None:
        reg_val = self.read_reg(reg)
        new_val = reg.fields[field_name].set(reg_val, value)
        self.write_reg(reg, new_val)
{% endfor %}
