{% for blk in blocks %}
// =============================================================================
// Standalone Self-Checking SystemVerilog Testbench
// Module: tb_{{ lower(blk.name) }}_reg_file
// Generated by rmap - Hardware Register Map Designer
// =============================================================================

`timescale 1ns / 1ps

module tb_{{ lower(blk.name) }}_reg_file;

  localparam int ADDR_WIDTH = 32;
  localparam int DATA_WIDTH = {{ reg_width }};
  localparam int STRB_WIDTH = DATA_WIDTH / 8;

  // Clock and Reset Signals
  logic                    clk_i;
  logic                    rst_ni;

  // Protocol Bus Master Interface
  logic                    bus_wr_en_i;
  logic                    bus_rd_en_i;
  logic [ADDR_WIDTH-1:0]   bus_addr_i;
  logic [DATA_WIDTH-1:0]   bus_wdata_i;
  logic [STRB_WIDTH-1:0]   bus_wstrb_i;
  logic [DATA_WIDTH-1:0]   bus_rdata_o;
  logic                    bus_ready_o;
  logic                    bus_error_o;
  logic                    last_bus_error;

  // Sideband Hardware Signals
{% for reg in blk.registers %}
  logic                    sw_{{ lower(reg.name) }}_wr_strobe_o;
  logic                    sw_{{ lower(reg.name) }}_rd_strobe_o;
{% for fld in reg.fields %}
{% if (upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS") and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i;
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i;
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o;
{% else if upper(fld.access) != "RO" %}
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o;
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
  logic                            hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i = 1'b0;
  logic [{{ fld.size_width }}-1:0] hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i = '0;
{% endif %}
{% endfor %}
{% endfor %}

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
  // Memory Passthrough Signals and Behavioral SRAM Models
{% for mem in blk.memories %}
  logic                    mem_{{ lower(mem.name) }}_req_o;
  logic                    mem_{{ lower(mem.name) }}_we_o;
  logic [ADDR_WIDTH-1:0]   mem_{{ lower(mem.name) }}_addr_o;
  logic [DATA_WIDTH-1:0]   mem_{{ lower(mem.name) }}_wdata_o;
  logic [STRB_WIDTH-1:0]   mem_{{ lower(mem.name) }}_wstrb_o;
  logic [DATA_WIDTH-1:0]   mem_{{ lower(mem.name) }}_rdata_i = '0;
  logic                    mem_{{ lower(mem.name) }}_ready_i = 1'b1;

  logic [DATA_WIDTH-1:0]   tb_sram_{{ lower(mem.name) }} [0:1023];
  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      mem_{{ lower(mem.name) }}_rdata_i <= '0;
    end else if (mem_{{ lower(mem.name) }}_req_o) begin
      if (mem_{{ lower(mem.name) }}_we_o) begin
        for (int b = 0; b < STRB_WIDTH; b++) begin
          if (mem_{{ lower(mem.name) }}_wstrb_o[b]) begin
            tb_sram_{{ lower(mem.name) }}[(mem_{{ lower(mem.name) }}_addr_o >> 2) & 10'h3FF][b*8 +: 8] <= mem_{{ lower(mem.name) }}_wdata_o[b*8 +: 8];
          end
        end
      end
      mem_{{ lower(mem.name) }}_rdata_i <= tb_sram_{{ lower(mem.name) }}[(mem_{{ lower(mem.name) }}_addr_o >> 2) & 10'h3FF];
    end
  end
{% endfor %}
{% endif %}

  // Verification Counters
  int pass_count = 0;
  int fail_count = 0;

  // Clock Generation (100 MHz, 10ns period)
  initial begin
    clk_i = 1'b0;
    forever #5 clk_i = ~clk_i;
  end

  // DUT Instantiation
  {{ lower(blk.name) }}_reg_file #(
    .ADDR_WIDTH(ADDR_WIDTH),
    .DATA_WIDTH(DATA_WIDTH)
  ) dut (
    .clk_i                     (clk_i),
    .rst_ni                    (rst_ni),
{% for reg in blk.registers %}
    .sw_{{ lower(reg.name) }}_wr_strobe_o (sw_{{ lower(reg.name) }}_wr_strobe_o),
    .sw_{{ lower(reg.name) }}_rd_strobe_o (sw_{{ lower(reg.name) }}_rd_strobe_o),
{% for fld in reg.fields %}
{% if (upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS") and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i),
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% else if upper(fld.access) != "RO" %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o     (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_o),
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i  (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i),
    .hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i (hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i),
{% endif %}
{% endfor %}
{% endfor %}
{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
{% for mem in blk.memories %}
    .mem_{{ lower(mem.name) }}_req_o   (mem_{{ lower(mem.name) }}_req_o),
    .mem_{{ lower(mem.name) }}_we_o    (mem_{{ lower(mem.name) }}_we_o),
    .mem_{{ lower(mem.name) }}_addr_o  (mem_{{ lower(mem.name) }}_addr_o),
    .mem_{{ lower(mem.name) }}_wdata_o (mem_{{ lower(mem.name) }}_wdata_o),
    .mem_{{ lower(mem.name) }}_wstrb_o (mem_{{ lower(mem.name) }}_wstrb_o),
    .mem_{{ lower(mem.name) }}_rdata_i (mem_{{ lower(mem.name) }}_rdata_i),
    .mem_{{ lower(mem.name) }}_ready_i (mem_{{ lower(mem.name) }}_ready_i),
{% endfor %}
{% endif %}
    .bus_wr_en_i               (bus_wr_en_i),
    .bus_rd_en_i               (bus_rd_en_i),
    .bus_addr_i                (bus_addr_i),
    .bus_wdata_i               (bus_wdata_i),
    .bus_wstrb_i               (bus_wstrb_i),
    .bus_rdata_o               (bus_rdata_o),
    .bus_ready_o               (bus_ready_o),
    .bus_error_o               (bus_error_o)
  );

  // =========================================================================
  // Bus Master Protocol Tasks
  // =========================================================================
  task automatic bus_write(
    input [ADDR_WIDTH-1:0] addr,
    input [DATA_WIDTH-1:0] data,
    input [STRB_WIDTH-1:0] strb
  );
    @(posedge clk_i);
    bus_wr_en_i <= 1'b1;
    bus_rd_en_i <= 1'b0;
    bus_addr_i  <= addr;
    bus_wdata_i <= data;
    bus_wstrb_i <= strb;
    @(posedge clk_i);
    while (!bus_ready_o) @(posedge clk_i);
    last_bus_error = bus_error_o;
    bus_wr_en_i <= 1'b0;
    bus_wstrb_i <= '0;
  endtask

  task automatic bus_read(
    input  [ADDR_WIDTH-1:0] addr,
    output [DATA_WIDTH-1:0] data
  );
    @(posedge clk_i);
    bus_wr_en_i <= 1'b0;
    bus_rd_en_i <= 1'b1;
    bus_addr_i  <= addr;
    @(posedge clk_i);
    while (!bus_ready_o) @(posedge clk_i);
    data = bus_rdata_o;
    last_bus_error = bus_error_o;
    bus_rd_en_i <= 1'b0;
  endtask

  task automatic check_val(
    input string reg_name,
    input [DATA_WIDTH-1:0] actual,
    input [DATA_WIDTH-1:0] expected,
    input [DATA_WIDTH-1:0] mask
  );
    if ((actual & mask) === (expected & mask)) begin
      pass_count++;
      $display("  [PASS] %s: Value = 0x%08h (Mask = 0x%08h)", reg_name, actual, mask);
    end else begin
      fail_count++;
      $display("  [FAIL] %s: Expected 0x%08h, Got 0x%08h (Mask = 0x%08h)", reg_name, expected, actual, mask);
    end
  endtask

  // =========================================================================
  // Test Sequence
  // =========================================================================
  initial begin
    logic [DATA_WIDTH-1:0] rdata;

    $display("\n=======================================================");
    $display("Starting Self-Checking Testbench for: {{ blk.name }}");
    $display("=======================================================");

    // Initialize Bus Signals
    bus_wr_en_i = 1'b0;
    bus_rd_en_i = 1'b0;
    bus_addr_i  = '0;
    bus_wdata_i = '0;
    bus_wstrb_i = '0;

    // Initialize Sideband Inputs
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if (upper(fld.access) == "RO" or upper(fld.access) == "RC" or upper(fld.access) == "RS") and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i = '0;
{% else if upper(fld.access) == "W1C" or upper(fld.access) == "W0C" %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i = '0;
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i = 1'b0;
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i = '0;
{% endif %}
{% endfor %}
{% endfor %}

    // -----------------------------------------------------------------------
    // Phase 1: Reset and Default Value Check
    // -----------------------------------------------------------------------
    $display("\n[Phase 1] Reset & Power-On Defaults Verification");
    rst_ni = 1'b0;
    repeat (5) @(posedge clk_i);
    rst_ni = 1'b1;
    repeat (2) @(posedge clk_i);

{% for reg in blk.registers %}
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
    check_val("{{ reg.name }}_reset", rdata, {{ sv_hex(reg.reset_val, reg_width) }}, '1);
{% endfor %}

    // -----------------------------------------------------------------------
    // Phase 2: Access Policy Verification
    // -----------------------------------------------------------------------
    $display("\n[Phase 2] Access Policy Verification");

{% for reg in blk.registers %}
    // Test Register: {{ reg.name }} (Offset: {{ reg.offset_hex }})
    bus_write({{ sv_hex(reg.offset_hex, 32) }}, 32'hFFFFFFFF, {STRB_WIDTH{1'b1}});
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" %}
    check_val("{{ reg.name }}.{{ fld.name }}_RW_write_1", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), (1 << {{ fld.size_width }}) - 1, '1);
{% else if upper(fld.access) == "RO" %}
    check_val("{{ reg.name }}.{{ fld.name }}_RO_no_sw_mod", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), ({{ sv_hex(reg.reset_val, reg_width) }} >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), '1);
{% else if upper(fld.access) == "W1C" %}
    check_val("{{ reg.name }}.{{ fld.name }}_W1C_cleared", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), 0, '1);
{% endif %}
{% endfor %}

    // Clear RW fields back to 0
    bus_write({{ sv_hex(reg.offset_hex, 32) }}, 32'h00000000, {STRB_WIDTH{1'b1}});
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
{% for fld in reg.fields %}
{% if upper(fld.access) == "RW" %}
    check_val("{{ reg.name }}.{{ fld.name }}_RW_write_0", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), 0, '1);
{% endif %}
{% endfor %}

{% endfor %}

    // -----------------------------------------------------------------------
    // Phase 3: Byte Strobe Masking Verification
    // -----------------------------------------------------------------------
    $display("\n[Phase 3] Byte Strobe Masking Verification");
{% if length(blk.registers) > 0 %}
    // 1. Zero-strobe write: writes with strb=0 must not modify storage
    bus_write({{ sv_hex(blk.registers.0.offset_hex, 32) }}, 32'hFFFFFFFF, '0);
    bus_read({{ sv_hex(blk.registers.0.offset_hex, 32) }}, rdata);
{% for fld in blk.registers.0.fields %}
{% if upper(fld.access) == "RW" %}
    check_val("{{ blk.registers.0.name }}.{{ fld.name }}_zero_strobe_masked", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), 0, '1);
{% endif %}
{% endfor %}

    // 2. Byte lane 0 write: write all 1s with strobe for byte 0 only
    bus_write({{ sv_hex(blk.registers.0.offset_hex, 32) }}, 32'hFFFFFFFF, 4'b0001);
    bus_read({{ sv_hex(blk.registers.0.offset_hex, 32) }}, rdata);
{% for fld in blk.registers.0.fields %}
{% if upper(fld.access) == "RW" and fld.offset_lsb < 8 %}
    check_val("{{ blk.registers.0.name }}.{{ fld.name }}_byte0_strobe", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), (1 << {{ fld.size_width }}) - 1, '1);
{% endif %}
{% endfor %}

    // 3. Byte lane 1 write: write 0s to byte lane 1 only; byte lane 0 must remain 1s
    bus_write({{ sv_hex(blk.registers.0.offset_hex, 32) }}, 32'h00000000, 4'b0010);
    bus_read({{ sv_hex(blk.registers.0.offset_hex, 32) }}, rdata);
{% for fld in blk.registers.0.fields %}
{% if upper(fld.access) == "RW" and fld.offset_lsb < 8 %}
    check_val("{{ blk.registers.0.name }}.{{ fld.name }}_byte0_preserved", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), (1 << {{ fld.size_width }}) - 1, '1);
{% endif %}
{% endfor %}

    // 4. Clear byte lane 0
    bus_write({{ sv_hex(blk.registers.0.offset_hex, 32) }}, 32'h00000000, 4'b0001);
    bus_read({{ sv_hex(blk.registers.0.offset_hex, 32) }}, rdata);
{% for fld in blk.registers.0.fields %}
{% if upper(fld.access) == "RW" and fld.offset_lsb < 8 %}
    check_val("{{ blk.registers.0.name }}.{{ fld.name }}_byte0_cleared", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), 0, '1);
{% endif %}
{% endfor %}
{% endif %}

    // -----------------------------------------------------------------------
    // Phase 4: Hardware Sideband Port Interaction
    // -----------------------------------------------------------------------
    $display("\n[Phase 4] Hardware Sideband Interaction Verification");
{% for reg in blk.registers %}
{% for fld in reg.fields %}
{% if upper(fld.access) == "RO" and (!existsIn(fld, "hw_access") or upper(fld.hw_access) != "NA") %}
    // Hardware drives RO input: {{ reg.name }}.{{ fld.name }}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i = {({{ fld.size_width }}){1'b1}};
    @(posedge clk_i);
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
    check_val("{{ reg.name }}.{{ fld.name }}_hw_input", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), (1 << {{ fld.size_width }}) - 1, '1);
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_i = '0;
{% else if upper(fld.access) == "W1C" %}
    // Hardware sets W1C flag via sideband pulse: {{ reg.name }}.{{ fld.name }}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i = {({{ fld.size_width }}){1'b1}};
    @(posedge clk_i);
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_set_i = '0;
    @(posedge clk_i);
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
    check_val("{{ reg.name }}.{{ fld.name }}_hw_pulse_set", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), (1 << {{ fld.size_width }}) - 1, '1);
    // Clear it via software write-1
    bus_write({{ sv_hex(reg.offset_hex, 32) }}, ((1 << {{ fld.size_width }}) - 1) << {{ fld.offset_lsb }}, {STRB_WIDTH{1'b1}});
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
    check_val("{{ reg.name }}.{{ fld.name }}_sw_clear_after_hw", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), 0, '1);
{% endif %}
{% if existsIn(fld, "hw_access") and (upper(fld.hw_access) == "WO" or upper(fld.hw_access) == "RW") %}
    // Hardware updates storage via sideband write: {{ reg.name }}.{{ fld.name }}
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i = 1'b1;
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_wdata_i = {({{ fld.size_width }}){1'b1}};
    @(posedge clk_i);
    hw_{{ lower(reg.name) }}_{{ lower(fld.name) }}_we_i = 1'b0;
    @(posedge clk_i);
    bus_read({{ sv_hex(reg.offset_hex, 32) }}, rdata);
    check_val("{{ reg.name }}.{{ fld.name }}_hw_write", (rdata >> {{ fld.offset_lsb }}) & ((1 << {{ fld.size_width }}) - 1), (1 << {{ fld.size_width }}) - 1, '1);
{% endif %}
{% endfor %}
{% endfor %}

    // -----------------------------------------------------------------------
    // Phase 5: Unmapped Address Decode Error Verification
    // -----------------------------------------------------------------------
    $display("\n[Phase 5] Unmapped Address Decode Error Verification");
    bus_read(32'hFFFF_FFF0, rdata);
    if (last_bus_error === 1'b1) begin
      pass_count++;
      $display("  [PASS] Unmapped address 0xFFFFFFF0 correctly asserted bus_error_o");
    end else begin
      fail_count++;
      $display("  [FAIL] Unmapped address 0xFFFFFFF0 did not assert bus_error_o");
    end

{% if existsIn(blk, "memories") and length(blk.memories) > 0 %}
    // -----------------------------------------------------------------------
    // Phase 6: Memory Subsystem Passthrough Verification
    // -----------------------------------------------------------------------
    $display("\n[Phase 6] Memory Subsystem Passthrough Verification");
{% for mem in blk.memories %}
    bus_write({{ sv_hex(mem.offset_hex, 32) }}, 32'hDEAD_BEEF, '1);
    bus_read({{ sv_hex(mem.offset_hex, 32) }}, rdata);
    check_val("Memory Passthrough {{ mem.name }} @ {{ mem.offset_hex }}", rdata, 32'hDEAD_BEEF, '1);
    if (last_bus_error === 1'b0) begin
      pass_count++;
      $display("  [PASS] Memory {{ mem.name }} access correctly asserted no bus_error_o");
    end else begin
      fail_count++;
      $display("  [FAIL] Memory {{ mem.name }} access asserted bus_error_o");
    end
{% endfor %}
{% endif %}

    // -----------------------------------------------------------------------
    // Final Summary & Exit
    // -----------------------------------------------------------------------
    $display("\n=======================================================");
    $display("Testbench Execution Summary: %0d Passed, %0d Failed", pass_count, fail_count);
    $display("=======================================================");

    if (fail_count == 0 && pass_count > 0) begin
      $display("RESULT: SUCCESS - ALL ASSERTIONS PASSED!\n");
      $finish(0);
    end else begin
      $display("RESULT: FAILED - ASSERTIONS FAILED!\n");
      $finish(1);
    end
  end

endmodule
{% endfor %}
