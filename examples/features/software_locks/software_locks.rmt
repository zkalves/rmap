  template_outputs {
    template_filename: "./templates/systemrdl/reg_map.rdl.inja"
    output_filepath: "./work/systemrdl/reg_map.rdl"
  }
  reg_width: 32
  hw_precedence: true
}
item {
  child_id: 1
}
item {
  kind: BLK
  id: 1
  child_id: 2
  child_id: 5
  child_id: 7
  child_id: 9
  itemData {
    key: "Name"
    value: "SECURITY_CORE"
  }
  itemData {
    key: "Description"
    value: "Security Core peripheral demonstrating 3-level hierarchical software read and write locks"
  }
  itemData {
    key: "Lock"
    value: "[w] hw_tamper_lock_i; [r] hw_debug_lock_i"
  }
  itemData {
    key: "Write Lock"
    value: "hw_tamper_lock_i"
  }
  itemData {
    key: "Read Lock"
    value: "hw_debug_lock_i"
  }
}
