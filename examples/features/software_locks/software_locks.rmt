  }
  itemData {
    key: "Description"
    value: "Secret key register guarded by composite write lock and read lock"
  }
  itemData {
    key: "Lock"
    value: "[w] hw_sec_lock_i || (SEC_CTRL.LOCK_BIT == 1); [r] hw_read_lock_i"
  }
  itemData {
    key: "Write Lock"
    value: "hw_sec_lock_i || (SEC_CTRL.LOCK_BIT == 1)"
  }
  itemData {
    key: "Read Lock"
    value: "hw_read_lock_i"
  }
}
