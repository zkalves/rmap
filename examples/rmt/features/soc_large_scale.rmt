    output_filepath: "./work/uvm/reg_model.sv"
  }
  template_outputs {
    template_filename: "./templates/rust/reg_map.rs.inja"
    output_filepath: "./work/rust/reg_map.rs"
  }
  template_outputs {
    template_filename: "./templates/python/reg_map.py.inja"
    output_filepath: "./work/python/reg_map.py"
  }
  template_outputs {
    template_filename: "./templates/html/reg_doc.html.inja"
    output_filepath: "./work/html/reg_doc.html"
  }
  template_outputs {
    template_filename: "./templates/markdown/reg_doc.md.inja"
    output_filepath: "./work/markdown/reg_doc.md"
  }
  template_outputs {
    template_filename: "./templates/systemrdl/reg_map.rdl.inja"
    output_filepath: "./work/systemrdl/reg_map.rdl"
  }
  template_outputs {
    template_filename: "./templates/ipxact/reg_map.xml.inja"
    output_filepath: "./work/ipxact/reg_map.xml"
  }
  template_outputs {
    template_filename: "./templates/svd/reg_map.xml.inja"
    output_filepath: "./work/svd/reg_map.xml"
  }
  template_outputs {
    template_filename: "./templates/json/reg_map.json.inja"
    output_filepath: "./work/json/reg_map.json"
  }
  template_outputs {
    template_filename: "./templates/rtl_tb/tb_reg_map.sv.inja"
    output_filepath: "./work/sim/tb_reg_map.sv"
  }
  template_outputs {
    template_filename: "./templates/pyuvm_tb/tb_pyuvm.py.inja"
    output_filepath: "./work/sim/tb_pyuvm.py"
  }
  template_outputs {
    template_filename: "./templates/uvm_tb/reg_bus_if.sv.inja"
    output_filepath: "./work/sim/uvm/reg_bus_if.sv"
  }
  template_outputs {
    template_filename: "./templates/uvm_tb/reg_bus_pkg.sv.inja"
    output_filepath: "./work/sim/uvm/reg_bus_pkg.sv"
  }
  template_outputs {
    template_filename: "./templates/uvm_tb/reg_env.sv.inja"
    output_filepath: "./work/sim/uvm/reg_env.sv"
  }
  template_outputs {
    template_filename: "./templates/uvm_tb/reg_tests.sv.inja"
    output_filepath: "./work/sim/uvm/reg_tests.sv"
  }
  template_outputs {
    template_filename: "./templates/uvm_tb/tb_top.sv.inja"
    output_filepath: "./work/sim/uvm/tb_top.sv"
  }
  template_outputs {
    template_filename: "./templates/sim/Makefile.inja"
    output_filepath: "./work/sim/Makefile"
  }
  reg_width: 32
  project_name: "SoC_Enterprise_Platform"
  project_version: "2.5.0"
  strict_validation: true
  pythonScript: "../../scripts/post_generate.py"
  python_script_enabled: true
  template_folders: "./templates"
  template_folders: "./custom_templates"
  custom_parameters {
    key: "company_name"
    value: "Acme Semi"
  }
  custom_parameters {
    key: "target_asic_node"
    value: "7nm_FinFET"
  }
  custom_parameters {
    key: "clock_freq_mhz"
    value: "1200"
  }
  custom_parameters {
    key: "bus_protocol"
    value: "AXI4_Full"
  }
}
